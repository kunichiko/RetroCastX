# Python
__pycache__/
*.pyc
.venv/

# FPGA build artifacts
gateware/build/

# Receiver dumps
*.ppm

# macOS
.DS_Store

# Claude Code local settings
.claude/settings.local.json

# atopile
hardware/*/build/
.ato/
standalone/

# gateware dev env
gateware/.venv/
gateware/litex-src/
gateware/litex_setup.py

# Rust client
client/target/

# 配布物の組み立て先(GitHub Actions と packaging/macos/bundle.sh の出力)
/dist/

# フラッシュ退避(工場LED受信カードFW等、コミット不要のバイナリ)
gateware/backups/

# 保管したビットストリーム(A/B比較用。バイナリはコミットしない)
gateware/bitstreams/

# 実機から録音した確認用WAV(生成物)
*.wav

# メーカー配布のデータシート(再配布が許諾されていないのでコミットしない)。
# 各 datasheets/README.md に入手元だけを残す。
#
# ディレクトリ指定にしていたら atopile が parts/ に落とすPDFが素通りしたので、
# 全体を対象にしている。自作PDFを入れたいときだけ git add -f すること。
*.pdf
*.PDF

# KiCad の編集ロック(そのマシンでの編集中を示す一時ファイル。追跡しない)
*.lck

# KiCad の自動保存(pcbnew実行中に生成される。コミットしない)
_autosave-*.kicad_pcb

# Fabrication Toolkit のタイムスタンプ付きバックアップ(zip本体を追跡するので不要)
hardware/adc-frontend/layouts/default/production/backups/

# Excel/Office が開いている間だけ作るロックファイル
~$*
.~lock.*#
