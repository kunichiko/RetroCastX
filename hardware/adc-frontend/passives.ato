import Resistor
import Capacitor
import is_atomic_part
import has_part_picked
import has_designator_prefix

component R75_0402 from Resistor:
    trait is_atomic_part<manufacturer="UNI-ROYAL", partnumber="0402WGF750JTCE", footprint="parts/UNI_ROYAL_0402WGF750JTCE/R0402.kicad_mod", symbol="parts/UNI_ROYAL_0402WGF750JTCE/0402WGF750JTCE.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C25133", manufacturer="UNI-ROYAL", partno="0402WGF750JTCE">
    trait has_designator_prefix<prefix="R">
    assert resistance within 74.25ohm to 75.75ohm

