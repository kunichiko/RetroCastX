# =============================================================================
# RetroCastX ADC front-end: TVP7002 breakout for Colorlight i5 EXT board
#
# Retro PC analog RGB (VGA HD-15) -> TVP7002 (triple ADC + H-PLL) ->
# 24bit parallel + DATACLK/HSOUT/VSOUT/SOGOUT -> PMOD-style 2x6 headers.
#
# 回路の根拠:
#  - TI TVP7002 datasheet SLES206C(電源系統・PLLフィルタ・入力終端)
#  - OSSC rev1.8 (marqs85/ossc_pcb) の実機BOM(同期系・ESD・フェライト)
# =============================================================================


# --- Parts (footprints: VS Code上で `ato create part` により後付けする) -----

component Tvp7002:
    """TI TVP7002 triple 8/10-bit 165/110MSPS video digitizer w/ H-PLL.

    HTQFP-100 (PZP). LCSC: C3824085 / DigiKey: TVP7002PZPR
    """
    trait is_atomic_part<manufacturer="TI", partnumber="TVP7002PZP", footprint="parts/TI_TVP7002PZP/HTQFP-100_L14.0-W14.0-P0.50-LS16.0-BL-EP6.2.kicad_mod", symbol="parts/TI_TVP7002PZP/TVP7002PZP.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C3824085", manufacturer="TI", partno="TVP7002PZP">
    trait has_designator_prefix<prefix="U">

    # Analog inputs
    signal sogin_1 ~ pin 1
    signal gin_1 ~ pin 2
    signal rin_3 ~ pin 9
    signal rin_2 ~ pin 10
    signal rin_1 ~ pin 11
    signal bin_3 ~ pin 16
    signal bin_2 ~ pin 17
    signal bin_1 ~ pin 18
    signal gin_4 ~ pin 96
    signal sogin_3 ~ pin 97
    signal gin_3 ~ pin 98
    signal sogin_2 ~ pin 99
    signal gin_2 ~ pin 100

    # Power: A33VDD (analog 3.3V)
    signal a33vdd ~ pin 13
    a33vdd ~ pin 14
    a33vdd ~ pin 93
    a33vdd ~ pin 94
    signal a33gnd ~ pin 12
    a33gnd ~ pin 15
    a33gnd ~ pin 92
    a33gnd ~ pin 95

    # Power: AVDD (analog core 1.9V)
    signal avdd ~ pin 4
    avdd ~ pin 6
    avdd ~ pin 7
    avdd ~ pin 19
    signal agnd ~ pin 3
    agnd ~ pin 5
    agnd ~ pin 8
    agnd ~ pin 20

    # Power: PLL AVDD (1.9V)
    signal pll_avdd ~ pin 84
    pll_avdd ~ pin 85
    signal pll_agnd ~ pin 83
    pll_agnd ~ pin 86
    pll_agnd ~ pin 90

    # Power: DVDD (digital core 1.9V)
    signal dvdd ~ pin 39
    dvdd ~ pin 69
    signal dgnd ~ pin 40
    dgnd ~ pin 68

    # Power: IOVDD (output drivers 3.3V)
    signal iovdd ~ pin 26
    iovdd ~ pin 41
    iovdd ~ pin 53
    iovdd ~ pin 66
    signal iognd ~ pin 27
    iognd ~ pin 42
    iognd ~ pin 54
    iognd ~ pin 60
    iognd ~ pin 67

    # Substrate -> analog ground
    signal nsub ~ pin 21
    nsub ~ pin 91

    # Digital video outputs (B/G/R 10bit each, MSB=_9)
    signal b0 ~ pin 29
    signal b1 ~ pin 30
    signal b2 ~ pin 31
    signal b3 ~ pin 32
    signal b4 ~ pin 33
    signal b5 ~ pin 34
    signal b6 ~ pin 35
    signal b7 ~ pin 36
    signal b8 ~ pin 37
    signal b9 ~ pin 38
    signal g0 ~ pin 43
    signal g1 ~ pin 44
    signal g2 ~ pin 45
    signal g3 ~ pin 46
    signal g4 ~ pin 47
    signal g5 ~ pin 48
    signal g6 ~ pin 49
    signal g7 ~ pin 50
    signal g8 ~ pin 51
    signal g9 ~ pin 52
    signal r0 ~ pin 55
    signal r1 ~ pin 56
    signal r2 ~ pin 57
    signal r3 ~ pin 58
    signal r4 ~ pin 59
    signal r5 ~ pin 61
    signal r6 ~ pin 62
    signal r7 ~ pin 63
    signal r8 ~ pin 64
    signal r9 ~ pin 65

    # Timing / status outputs
    signal fidout ~ pin 22
    signal vsout ~ pin 23
    signal hsout ~ pin 24
    signal sogout ~ pin 25
    signal dataclk ~ pin 28

    # Control
    signal pwdn ~ pin 70
    signal resetb ~ pin 71
    signal tms ~ pin 72
    signal i2ca ~ pin 73
    signal scl ~ pin 74
    signal sda ~ pin 75
    signal clamp ~ pin 76
    signal coast ~ pin 77

    # Sync inputs / ext clock
    signal vsync_a ~ pin 78
    signal vsync_b ~ pin 79
    signal ext_clk ~ pin 80
    signal hsync_a ~ pin 81
    signal hsync_b ~ pin 82

    # H-PLL loop filter
    signal filt1 ~ pin 87
    signal filt2 ~ pin 88
    signal pll_f ~ pin 89


