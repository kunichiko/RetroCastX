    signal ct ~ pin P1          # チップ側センタータップ共通
    signal bobsmith ~ pin P10   # Bob-Smith/シャーシ基準
    signal led_g_a ~ pin 11
    signal led_g_k ~ pin 12
    signal led_y_a ~ pin 14
    signal led_y_k ~ pin 13
    signal shield ~ pin SHIELD0
    shield ~ pin SHIELD1


module VideoInputChannel:
    """1ch分のアナログ入力段: 75Ω終端 -> 100nF ACカップリング -> TVP入力。"""
    signal input
    signal output
    power = new ElectricPower  # 終端のグラウンド基準

    r_term = new R75_0402
    input ~> r_term ~> power.lv

    c_ac = new C100nF_0402
    input ~> c_ac ~> output


module AudioAdc:
    """PCM1808 1個分: ACカップリング + VREF/電源デカップリング + モードストラップ。

    スレーブ・I2S固定(FMT/MD1/MD0=GND)。SCKI/BCK/LRCはFPGA側と共有バスで受ける。
    """
    adc = new Pcm1808
    signal gnd
    signal in_l
    signal in_r
    power_5va = new ElectricPower   # オーディオアナログ5V(ビーズ分離後)
    power_3v3 = new ElectricPower

    adc.vcc ~ power_5va.hv
    adc.vdd ~ power_3v3.hv
    adc.agnd ~ gnd
    adc.dgnd ~ gnd
    adc.fmt ~ gnd
    adc.md1 ~ gnd
    adc.md0 ~ gnd

    # 入力ACカップリング(PCM1808は内部バイアス、データシート標準回路は直列1µF)
    c_in_l = new C1uF_0603
    c_in_r = new C1uF_0603
    in_l ~> c_in_l ~> adc.vinl
    in_r ~> c_in_r ~> adc.vinr

    # VREF・電源デカップリング
    c_vref_a = new C10uF_0805
    c_vref_b = new C100nF_0402
    adc.vref ~> c_vref_a ~> gnd
    adc.vref ~> c_vref_b ~> gnd
    dec = new C100nF_0402[2]
    adc.vcc ~> dec[0] ~> gnd
    adc.vdd ~> dec[1] ~> gnd


module PowerTree:
    """5V入力 -> 3.3V(IO/デジタル) + 3.3V(アナログ) + 1.85V(AVDD/PLL) + 1.9V(DVDD)。

    AVDD/PLL_AVDD系は RT9013-18(固定1.85V, 500mA, SOT-23-5)を「3.3Vアナログ
    レール(p3v3_a)から」降圧。1.85VはTVP7002推奨範囲(1.8〜2.0V)内。5V直接降圧
    (旧AZ1117H-ADJ, SOT-223, ~0.9W)を廃し、ドロップを1.45Vに下げ損失~0.35Wに削減
    →小型SOT-23-5化。その分p3v3_aのLDO(ldo_a33)が+~0.3A負担(SOT-223で余裕)。
    DVDDも同様にTLV70019(1.9V)を3.3Vから。
    """
    power_5v = new ElectricPower
    p3v3_io = new ElectricPower
    p3v3_a = new ElectricPower
    p1v9_a = new ElectricPower
    p1v9_d = new ElectricPower

    ldo_io = new Az1117Fixed33
    ldo_a33 = new Az1117Fixed33
    ldo_a19 = new RICHTEK_RT9013_18GB_package   # AVDD/PLL 1.85V(3.3Vから)
    ldo_d19 = new Tlv70019

    # 共通GND
    signal gnd
    gnd ~ power_5v.lv
    gnd ~ p3v3_io.lv
    gnd ~ p3v3_a.lv
    gnd ~ p1v9_a.lv
    gnd ~ p1v9_d.lv
    gnd ~ ldo_io.gnd
    gnd ~ ldo_a33.gnd
    gnd ~ ldo_a19.GND
    gnd ~ ldo_d19.gnd

    ldo_io.vin ~ power_5v.hv
    ldo_io.out ~ p3v3_io.hv
    ldo_a33.vin ~ power_5v.hv
    ldo_a33.out ~ p3v3_a.hv
    # AVDD/PLL 1.85V: RT9013-18を3.3Vアナログレールから(固定出力=分圧不要)
    ldo_a19.VIN ~ p3v3_a.hv
    ldo_a19.EN ~ p3v3_a.hv       # 常時イネーブル
    ldo_a19.VOUT ~ p1v9_a.hv
    ldo_d19.vin ~ p3v3_io.hv
    ldo_d19.en ~ p3v3_io.hv
    ldo_d19.out ~ p1v9_d.hv

    # 入出力バルクコンデンサ(AZ1117は出力に≥10µFのESR安定性要求あり)
    bulk_caps = new C10uF_0805[5]
    power_5v.hv ~> bulk_caps[0] ~> gnd
    p3v3_io.hv ~> bulk_caps[1] ~> gnd
    p3v3_a.hv ~> bulk_caps[2] ~> gnd
    p1v9_a.hv ~> bulk_caps[3] ~> gnd
    p1v9_d.hv ~> bulk_caps[4] ~> gnd

    assert power_5v.voltage within 4.5V to 5.5V


module EthernetPort:
    """GbE出口: EXT P1 の ETH2/ETH1 両ペアを 2つの MagJack へ(デュアルポート)。

    回路は kazkojima 氏 i5ether(1000BASE-T netboot/nfsroot 実績あり)に準拠:
    - MDIペアは PHY から DC結合のまま(直列部品なし)
    - PHY側センタータップ: 各0.1µF→GND のみ(B50612D は内部バイアスで無給電可)
    - Bob-Smith終端(75Ω+1nF)は HR911130A 内蔵
    - 論理GND-シャーシ間: 各ポート 4.7nF/2kV ×2(1812)
    - **ETH2=jack=PHY0=litex eth1(映像ストリーム既定)、ETH1=jack2=PHY1=litex eth0(将来のデュアルリンク/2.5G化用)**
      ※litexのデフォルトindexは0=ETH1だが、gatewareはeth1(=ETH2)を要求して映像を出す。
    - LED: 両ポートのMagJack緑/黄LEDをFPGA GPIOで駆動(ETH2=io_r1/io_t1, ETH1=io_w1/io_v1)
    """
    signal gnd
    signal chassis
    # SO-DIMMから受けるMDIペア(モジュールI/O)。AppでSoDimmI5のeth*へ接続する。
    signal eth2_1_P; signal eth2_1_N; signal eth2_2_P; signal eth2_2_N
    signal eth2_3_P; signal eth2_3_N; signal eth2_4_P; signal eth2_4_N
    signal eth1_1_P; signal eth1_1_N; signal eth1_2_P; signal eth1_2_N
    signal eth1_3_P; signal eth1_3_N; signal eth1_4_P; signal eth1_4_N

    jack = new GbeMagJack    # ETH2 = phy0(既定の映像ストリーム)
    jack2 = new GbeMagJack   # ETH1 = phy1(デュアルリンクテスト用)

    # ETH2 → jack
    eth2_1_P ~ jack.mdi0_p
    eth2_1_N ~ jack.mdi0_n
    eth2_2_P ~ jack.mdi1_p
    eth2_2_N ~ jack.mdi1_n
    eth2_3_P ~ jack.mdi2_p
    eth2_3_N ~ jack.mdi2_n
    eth2_4_P ~ jack.mdi3_p
    eth2_4_N ~ jack.mdi3_n

    # ETH1 → jack2
    eth1_1_P ~ jack2.mdi0_p
    eth1_1_N ~ jack2.mdi0_n
    eth1_2_P ~ jack2.mdi1_p
    eth1_2_N ~ jack2.mdi1_n
    eth1_3_P ~ jack2.mdi2_p
    eth1_3_N ~ jack2.mdi2_n
    eth1_4_P ~ jack2.mdi3_p
    eth1_4_N ~ jack2.mdi3_n

    # チップ側センタータップ共通(P1)を各0.1µF→GNDでデカップリング(B50612Dは無給電可)
    ct_caps = new C100nF_0402[2]
    jack.ct ~> ct_caps[0] ~> gnd
    jack2.ct ~> ct_caps[1] ~> gnd

    # Bob-Smith基準(P10)とシェルはシャーシへ。シャーシ-GND間は4.7nF/2kV(各ポート2)
    jack.bobsmith ~ chassis
    jack.shield ~ chassis
    jack2.bobsmith ~ chassis
    jack2.shield ~ chassis

    # --- リンク/アクティビティLED: 両ポートの緑/黄をFPGA GPIOで駆動 ---
    # GPIO(3.3V) → R220 → アノード, カソード→GND(GPIO High=点灯, ~6mA)。
    # 点灯パターン(リンク/アクティビティ)はゲートウェアで生成。
    # ETH2=jack(io_r1/io_t1), ETH1=jack2(io_w1/io_v1)。GPIOはP6の同一クラスタでセット。
    signal led_g_drive    # ETH2 緑LED (App: sodimm.io_r1)
    signal led_y_drive    # ETH2 黄LED (App: sodimm.io_t1)
    signal led_g_drive2   # ETH1 緑LED (App: sodimm.io_w1)
    signal led_y_drive2   # ETH1 黄LED (App: sodimm.io_v1)
    r_led_g = new R220_0402
    r_led_y = new R220_0402
    r_led_g2 = new R220_0402
    r_led_y2 = new R220_0402
    led_g_drive ~> r_led_g ~> jack.led_g_a
    jack.led_g_k ~ gnd
    led_y_drive ~> r_led_y ~> jack.led_y_a
    jack.led_y_k ~ gnd
    led_g_drive2 ~> r_led_g2 ~> jack2.led_g_a
    jack2.led_g_k ~ gnd
    led_y_drive2 ~> r_led_y2 ~> jack2.led_y_a
    jack2.led_y_k ~ gnd
    bridge_caps = new C4nF7_1812_2kV[4]
    chassis ~> bridge_caps[0] ~> gnd
    chassis ~> bridge_caps[1] ~> gnd
    chassis ~> bridge_caps[2] ~> gnd
    chassis ~> bridge_caps[3] ~> gnd


# --- FT2232H: USB書換え(JTAG)+ UART の主経路 -----------------------------------
module Ft2232hProgrammer:
    """FT2232H (C27882): USB Hi-Speed → ch.A MPSSE=JTAG / ch.B=UART。
    i5をUSB経由で書換える主経路(openFPGALoader -c ft2232)。JTAGはポゴピン経由で
    i5底面のTCK/TMS/TDI/TDOパッドへ。EEPROM(93LC56)でVID/PID/シリアルを固定。
    電源は基板3.3V(USB接続時のみ立つ=バスパワー等価)。内部1.8V LDOでコア給電。"""
    signal gnd
    signal p3v3        # VCCIO / VREGIN = 3.3V
    signal usb_dp
    signal usb_dm
    # ch.A MPSSE → JTAG(ポゴピンへ)
    signal jtag_tck
    signal jtag_tdi
    signal jtag_tdo
    signal jtag_tms
    # ch.B → UART(i5と接続)
    signal uart_txd    # FT TXD → i5 RX
    signal uart_rxd    # FT RXD ← i5 TX

    ft = new FTDI_FT2232HL_REEL_package

    # --- 電源/GND ---
    ft.VCCIO ~ p3v3
    ft.VREGIN ~ p3v3
    ft.GND ~ gnd
    ft.AGND ~ gnd
    ft.TEST ~ gnd            # テストモード無効(GND固定)
    # 内部1.8V LDO: VREGOUT → VCORE。VPHY/VPLLはフェライトで分離給電。
    ft.VREGOUT ~ ft.VCORE
    fb_phy = new FerriteBead
    fb_pll = new FerriteBead
    ft.VREGOUT ~ fb_phy.p1
    fb_phy.p2 ~ ft.VPHY
    ft.VREGOUT ~ fb_pll.p1
    fb_pll.p2 ~ ft.VPLL

    # デカップリング(VCCIO×4 + 各電源)
    c_vccio = new C100nF_0402[4]
    ft.VCCIO ~> c_vccio[0] ~> gnd
    ft.VCCIO ~> c_vccio[1] ~> gnd
    ft.VCCIO ~> c_vccio[2] ~> gnd
    ft.VCCIO ~> c_vccio[3] ~> gnd
    c_vregin = new C100nF_0402
    ft.VREGIN ~> c_vregin ~> gnd
    c_vregin_bulk = new C10uF_0805
    ft.VREGIN ~> c_vregin_bulk ~> gnd
    c_vregout = new C100nF_0402
    ft.VREGOUT ~> c_vregout ~> gnd
    c_vregout_bulk = new C1uF_0603
    ft.VREGOUT ~> c_vregout_bulk ~> gnd
    c_vcore = new C100nF_0402
    ft.VCORE ~> c_vcore ~> gnd
    c_vphy = new C100nF_0402
    ft.VPHY ~> c_vphy ~> gnd
    c_vpll = new C100nF_0402
    ft.VPLL ~> c_vpll ~> gnd

    # REF: 12kΩ→GND(USB PLL基準電流)
    r_ref = new R12K_0402
    ft.REF ~> r_ref ~> gnd

    # nRESET: 10kΩプルアップ(内部PU有だが確実化)
    r_reset = new R10K_0402
    ft.nRESET ~> r_reset ~> p3v3

    # --- 12MHz水晶 + 負荷容量(CL=20pF品 → 33pF×2)---
    xtal = new YXC_X322512MSB4SI_package
    ft.OSCI ~ xtal.OSC1
    ft.OSCO ~ xtal.OSC2
    xtal.GND ~ gnd
    c_osci = new C33pF_0603
    ft.OSCI ~> c_osci ~> gnd
    c_osco = new C33pF_0603
    ft.OSCO ~> c_osco ~> gnd

    # --- 構成EEPROM 93LC56(x16固定, 'B')---
    ee = new MICROCHIP_93LC56BT_I_SN_package
    ee.CS ~ ft.EECS
    ee.CLK ~ ft.EECLK
    ee.DI ~ ft.EEDATA
    ee.DO ~ ft.EEDATA       # DI/DOはEEDATAで共通(FTDI標準)
    ee.VCC ~ p3v3
    ee.VSS ~ gnd
    c_ee = new C100nF_0402
    ee.VCC ~> c_ee ~> gnd

    # --- USB D+/D-(FT2232Hは直列抵抗内蔵→外付け27Ω不要)---
    ft.DP ~ usb_dp
    ft.DM ~ usb_dm

    # --- ch.A MPSSE = JTAG(openFPGALoader ft2232標準割当)---
    ft.ADBUS0 ~ jtag_tck    # TCK
    ft.ADBUS1 ~ jtag_tdi    # TDI (FT→DUT)
    ft.ADBUS2 ~ jtag_tdo    # TDO (DUT→FT, 入力)
    ft.ADBUS3 ~ jtag_tms    # TMS

    # --- ch.B = UART ---
    ft.BDBUS0 ~ uart_txd    # TXD (FT→i5 RX)
    ft.BDBUS1 ~ uart_rxd    # RXD (i5 TX→FT)


# --- Top level ----------------------------------------------------------------

module App:
    tvp = new Tvp7002
    vga = new Dsub15X68k
    buf_sync = new Lvc2g17
    osc = new Osc27M
    jack = new DcJack
    supply = new PowerTree

    # 電源レール
    power_5v = new ElectricPower
    p3v3_io = new ElectricPower
    p3v3_a = new ElectricPower
    p1v9_a = new ElectricPower
    p1v9_d = new ElectricPower
    power_5v ~ supply.power_5v
    p3v3_io ~ supply.p3v3_io
    p3v3_a ~ supply.p3v3_a
    p1v9_a ~ supply.p1v9_a
    p1v9_d ~ supply.p1v9_d

    signal gnd
    gnd ~ power_5v.lv

    # 5V給電 + USBデータ: J10 USB-C 1本で電源とFT2232H(書換え/UART)を兼ねる。
    #   CCにRd 5.1kΩ実装 → PD充電器+C-Cケーブルで5V/3A受電。同時にD+/D-を
    #   オンボードFT2232Hへ配線し、USB経由でi5をJTAG書換え + ch.B UART。
    #   FT2232Hは基板3.3V(USB VBUS→LDO由来)で動作=バスパワー等価(USB接続時のみ通電)。
    #   SJ1(閉=既定)でSO-DIMMの5Vピン経由でi5モジュールへ給電。
    #   代替入力: J7 DCジャック。J10とJ7は同時使用不可。
    usbc = new UsbCPowerReceptacle
    usbc.vbus ~ power_5v.hv
    usbc.gnd ~ gnd
    usbc.shell ~ gnd
    r_cc1 = new R5K1_0402
    r_cc2 = new R5K1_0402
    usbc.cc1 ~> r_cc1 ~> gnd
    usbc.cc2 ~> r_cc2 ~> gnd

    # --- オンボードFT2232H: USB書換え(JTAG)+ UART の主経路 ---
    ft2232 = new Ft2232hProgrammer
    ft2232.gnd ~ gnd
    ft2232.p3v3 ~ p3v3_io.hv
    ft2232.usb_dp ~ usbc.dp
    ft2232.usb_dm ~ usbc.dn
    # ch.B UART → SO-DIMM空きGPIO(i5側UART)
    ft2232.uart_txd ~ sodimm.io_w1   # FT TXD → i5 RX (P6 pin50)
    ft2232.uart_rxd ~ sodimm.io_v1   # i5 TX  → FT RXD (P6 pin52)

    # --- JTAG: ポゴピン4本でi5底面テストパッドへバネ接触 ---
    # 配置(KiCad実測): ソケット中心から縦33mm, TDO中心=右シルク線から横12mm,
    #   2.54mmピッチで右→左に TDO/TDI/TMS/TCK。
    pogo_tck = new PogoPin
    pogo_tms = new PogoPin
    pogo_tdi = new PogoPin
    pogo_tdo = new PogoPin
    pogo_tck.pad ~ ft2232.jtag_tck
    pogo_tms.pad ~ ft2232.jtag_tms
    pogo_tdi.pad ~ ft2232.jtag_tdi
    pogo_tdo.pad ~ ft2232.jtag_tdo
    ft2232.jtag_tck.override_net_name = "jtag_tck"  # 自動名が数値になるのを回避

    # JTAGデバッグ端子(念のための予備, コネクタ未実装/DNP): 同JTAG信号へ並列引き出し
    jtag_hdr = new HeaderJtag
    jtag_hdr.tck ~ ft2232.jtag_tck
    jtag_hdr.tms ~ ft2232.jtag_tms
    jtag_hdr.tdi ~ ft2232.jtag_tdi
    jtag_hdr.tdo ~ ft2232.jtag_tdo
    jtag_hdr.gnd ~ gnd
    jtag_hdr.vref ~ p3v3_io.hv

    signal p5v_ext
    sj_ext5v = new SolderJumper
    p5v_ext ~ sj_ext5v.a
    sj_ext5v.b ~ power_5v.hv
    jack.center ~ power_5v.hv
    jack.sleeve ~ gnd

    power_5v.voltage = 5V +/- 5%
    p3v3_io.voltage = 3.3V +/- 3%
    p3v3_a.voltage = 3.3V +/- 3%
    p1v9_a.voltage = 1.85V +/- 2%   # RT9013-18 固定1.85V(±2%), TVP推奨1.8〜2.0V内
    p1v9_d.voltage = 1.9V +/- 3%
    assert p1v9_a.voltage within 1.8V to 2.0V
    assert p1v9_d.voltage within 1.8V to 2.0V

    # TVP7002 電源接続(AVDD/PLL_AVDDはフェライトビーズで分離)
    fb_avdd = new FerriteBead
    fb_pll = new FerriteBead
    p1v9_a.hv ~ fb_avdd.p1
    fb_avdd.p2 ~ tvp.avdd
    p1v9_a.hv ~ fb_pll.p1
    fb_pll.p2 ~ tvp.pll_avdd

    tvp.a33vdd ~ p3v3_a.hv
    tvp.dvdd ~ p1v9_d.hv
    tvp.iovdd ~ p3v3_io.hv
    tvp.a33gnd ~ gnd
    tvp.agnd ~ gnd
    tvp.pll_agnd ~ gnd
    tvp.dgnd ~ gnd
    tvp.iognd ~ gnd
    tvp.nsub ~ gnd

    # デカップリング(各電源ピン群に100nF)
    dec_caps = new C100nF_0402[14]
    tvp.a33vdd ~> dec_caps[0] ~> gnd
    tvp.a33vdd ~> dec_caps[1] ~> gnd
    tvp.avdd ~> dec_caps[2] ~> gnd
    tvp.avdd ~> dec_caps[3] ~> gnd
    tvp.avdd ~> dec_caps[4] ~> gnd
    tvp.avdd ~> dec_caps[5] ~> gnd
    tvp.pll_avdd ~> dec_caps[6] ~> gnd
    tvp.pll_avdd ~> dec_caps[7] ~> gnd
    tvp.dvdd ~> dec_caps[8] ~> gnd
    tvp.dvdd ~> dec_caps[9] ~> gnd
    tvp.iovdd ~> dec_caps[10] ~> gnd
    tvp.iovdd ~> dec_caps[11] ~> gnd
    tvp.iovdd ~> dec_caps[12] ~> gnd
    tvp.iovdd ~> dec_caps[13] ~> gnd

    # --- アナログRGB入力(D-SUB15 -> RIN_3/GIN_3/BIN_3) ---
    ch_r = new VideoInputChannel
    ch_g = new VideoInputChannel
    ch_b = new VideoInputChannel
    ch_r.power ~ p3v3_a
    ch_g.power ~ p3v3_a
    ch_b.power ~ p3v3_a

    # アナログRGB経路のネット名は末尾のoverride_net_name一括ブロックで固定:
    #   入力=vin_r/vin_g/vin_b, TVP側出力=rin3/gin3/bin3, SOG=sogin3
    # → KiCadネットクラス Analog_RGB をこれらの名前で割当(.kicad_pro)。
    esd_rgb = new EsdArray4
    esd_rgb.gnd ~ gnd
    vga.r ~ esd_rgb.io1
    vga.g ~ esd_rgb.io2
    vga.b ~ esd_rgb.io3

    vga.r ~ ch_r.input
    vga.g ~ ch_g.input
    vga.b ~ ch_b.input
    ch_r.output ~ tvp.rin_3
    ch_g.output ~ tvp.gin_3
    ch_b.output ~ tvp.bin_3

    # green -> SOGIN_3 (Sync-on-Green / アナログcsync対応): 1nF結合
    c_sog3 = new C1nF_0402
    vga.g ~> c_sog3 ~> tvp.sogin_3

    # D-SUB15のGND(RGB各GND・共通GND・シェル)
    vga.gnd ~ gnd
    vga.r_gnd ~ gnd
    vga.g_gnd ~ gnd
    vga.b_gnd ~ gnd
    vga.shield ~ gnd

    # --- ArgusX接続用 2x8ボックスヘッダ(代替映像入力) ---
    # ArgusX(アナログRGBマトリクスセレクタ)の2x8出力ポートからリボンで受ける。
    # D-SUB15と同じ前段ノードへ並列接続(R/G/B・音声・同期)。使用は排他(片方のみ接続)。
    # 電源(pin13/15)は両基板とも自己給電のため未接続。
    argus = new BoxHeader2x8Argus
    argus.gnd ~ gnd
    argus.r ~ vga.r         # 前段(ESD+75Ω終端+ACカップリング)を共有
    argus.g ~ vga.g
    argus.b ~ vga.b
    argus.audio_l ~ vga.audio_l
    argus.audio_r ~ vga.audio_r
    argus.hsync ~ vga.hsync
    argus.vsync ~ vga.vsync

    # YS(D-SUB15 pin7): X68000のスーパーインポーズ/イメージユニット関連status。
    # capture用途では未使用だが、将来取り込む場合に備えテストパッドへ引き出す
    tp_ys = new Tp1Pad
    vga.ys ~ tp_ys.pad

    # --- TTL同期入力 (HS/VS or csync-on-HSYNC) ---
    esd_sync = new EsdArray4
    esd_sync.gnd ~ gnd
    vga.hsync ~ esd_sync.io1
    vga.vsync ~ esd_sync.io2

    # VSYNCはRC遅延(220Ω+1nF)を通す: VSYNC立ち上がりがHSYNCと完全一致すると
    # 内部同期処理が誤動作するため(datasheet推奨)
    r_vs = new R220_0402
    c_vs = new C1nF_0402
    signal vs_delayed
    vga.vsync ~> r_vs ~> vs_delayed
    vs_delayed ~> c_vs ~> gnd

    buf_sync.vcc ~ p3v3_io.hv
    buf_sync.gnd ~ gnd
    c_buf = new C100nF_0402
    buf_sync.vcc ~> c_buf ~> gnd
    vga.hsync ~ buf_sync.in_a
    vs_delayed ~ buf_sync.in_b
    buf_sync.out_a ~ tvp.hsync_a
    buf_sync.out_b ~ tvp.vsync_a

    # 未使用同期入力はGND
    tvp.hsync_b ~ gnd
    tvp.vsync_b ~ gnd

    # --- H-PLL ループフィルタ (FILT1 -> 1.5kΩ + 100nF -> PLL_F, FILT2 -> 4.7nF -> PLL_F) ---
    r_filt = new R1K5_0402
    c_filt1 = new C100nF_0402
    c_filt2 = new C4nF7_0402
    signal filt_mid
    tvp.filt1 ~> r_filt ~> filt_mid
    filt_mid ~> c_filt1 ~> tvp.pll_f
    tvp.filt2 ~> c_filt2 ~> tvp.pll_f

    # --- 27MHz基準クロック(モード検出の安定化用) ---
    osc.vcc ~ p3v3_io.hv
    osc.en ~ p3v3_io.hv
    osc.gnd ~ gnd
    osc.out ~ tvp.ext_clk
    c_osc = new C100nF_0402
    osc.vcc ~> c_osc ~> gnd

    # --- 未使用アナログ入力の処理(datasheet: video系10nF, SOG系1nFをGNDへ) ---
    nc_caps = new C10nF_0402[7]
    tvp.rin_1 ~> nc_caps[0] ~> gnd
    tvp.rin_2 ~> nc_caps[1] ~> gnd
    tvp.bin_1 ~> nc_caps[2] ~> gnd
    tvp.bin_2 ~> nc_caps[3] ~> gnd
    tvp.gin_1 ~> nc_caps[4] ~> gnd
    tvp.gin_2 ~> nc_caps[5] ~> gnd
    tvp.gin_4 ~> nc_caps[6] ~> gnd

    nc_sog_caps = new C1nF_0402[2]
    tvp.sogin_1 ~> nc_sog_caps[0] ~> gnd
    tvp.sogin_2 ~> nc_sog_caps[1] ~> gnd

    # --- 制御ピンのストラップ ---
    tvp.pwdn ~ gnd     # 常時動作
    tvp.tms ~ gnd      # スキャンテスト無効
    tvp.clamp ~ gnd    # クランプは内部タイミング使用
    tvp.coast ~ gnd

    # I2CA -> GND: I2Cアドレス 0xB8 (7bit: 0x5C)
    r_i2ca = new R2K2_0402
    tvp.i2ca ~> r_i2ca ~> gnd

    # I2C プルアップ
    r_sda = new R2K2_0402
    r_scl = new R2K2_0402
    tvp.sda ~> r_sda ~> p3v3_io.hv
    tvp.scl ~> r_scl ~> p3v3_io.hv

    # RESETB: プルダウン(FPGAがHighに駆動して解除)
    r_rst = new R2K2_0402
    tvp.resetb ~> r_rst ~> gnd

    # --- FPGA接続 (Colorlight i5 を DDR2 SO-DIMM 200P ソケットへ直挿し) ---
    # 旧 EXT P2/P4 ヘッダの全GPIOを SO-DIMM ピンへ移設(信号名 io_<ball> は不変)。
    # i5モジュールへは本ソケットの5V/GNDピン経由で給電する(EXTヘッダ廃止)。
    sodimm = new SoDimmI5
    sodimm.gnd ~ gnd
    sodimm.p5v ~ p5v_ext

    # === 映像・制御・タイミングのSO-DIMM割当(2026-08 再配置) ===
    # 映像 RGB888(各色上位8bit [9:2])。SO-DIMM昇順 ↔ TVP物理降順で単調=交差無し配線。
    #   P2(pin41-95): I2C/RESET(先頭3) + R2-R9 + G2-G9
    #   P3(pin99-137): B2-B9 を集中 + TVPタイミング(DATACLK/SOG/HS/VS/FID)
    # --- P2: I2C + リセット ---
    sodimm.io_u16 ~ tvp.sda      # pin41
    sodimm.io_k18 ~ tvp.scl      # pin49
    sodimm.io_c18 ~ tvp.resetb   # pin51
    # --- P2: R2-R9 ---
    sodimm.io_t18 ~ tvp.r2   # pin57
    sodimm.io_r18 ~ tvp.r3   # pin59
    sodimm.io_r17 ~ tvp.r4   # pin61
    sodimm.io_p17 ~ tvp.r5   # pin63
    sodimm.io_m17 ~ tvp.r6   # pin65
    sodimm.io_t17 ~ tvp.r7   # pin67
    sodimm.io_u18 ~ tvp.r8   # pin69
    sodimm.io_u17 ~ tvp.r9   # pin71
    # --- P2: G2-G9 ---
    sodimm.io_p18 ~ tvp.g2   # pin73
    sodimm.io_n17 ~ tvp.g3   # pin75
    sodimm.io_n18 ~ tvp.g4   # pin77
    sodimm.io_m18 ~ tvp.g5   # pin79
    sodimm.io_l20 ~ tvp.g6   # pin81
    sodimm.io_l18 ~ tvp.g7   # pin83
    sodimm.io_k20 ~ tvp.g8   # pin85
    sodimm.io_j20 ~ tvp.g9   # pin89
    # pin95(io_g20)は予備
    # --- P3: B2-B9(青を集中) ---
    sodimm.io_f20 ~ tvp.b2   # pin99
    sodimm.io_d20 ~ tvp.b3   # pin111
    sodimm.io_b20 ~ tvp.b4   # pin117
    sodimm.io_b19 ~ tvp.b5   # pin119
    sodimm.io_b18 ~ tvp.b6   # pin121
    sodimm.io_a19 ~ tvp.b7   # pin123
    sodimm.io_c17 ~ tvp.b8   # pin125
    sodimm.io_a18 ~ tvp.b9   # pin127
    # --- P3: TVPタイミング ---
    # DATACLK(ピクセルクロック)はFPGAのクロック網/PLLに入る必要があるため、
    # クロック対応ボールに置く。D3はPCLK非対応(prjtrellis iodb確認済み)なので、
    # P3唯一のクロック対応ピン E2=PCLKC7_0(pin151)へ割当。SOG/HS/VS/FIDは通常信号。
    sodimm.io_e2 ~ tvp.dataclk   # pin151 (E2=PCLKC7_0)
    sodimm.io_c4 ~ tvp.sogout    # pin131 (C4)
    sodimm.io_b4 ~ tvp.hsout     # pin133 (B4)
    sodimm.io_c3 ~ tvp.vsout     # pin135 (C3)
    sodimm.io_e3 ~ tvp.fidout    # pin137 (E3)
    # pin129(D3)は予備(クロック非対応のためDATACLKには不適)

    # --- 音声入力(3系統: DSUB15音声 / LINE入力 / S/PDIF光) ---
    # クロック系: 12.288MHz XO(=256fs@48kHz)を両ADCのSCKIとFPGA(F1=PCLKC6_1)へ。
    # BCK(64fs)/LRCK(fs)はFPGAがMCLKから分周して両ADCへ共通供給。DOUTのみ個別
    # → 2系統のアナログ音声を同時キャプチャ可能。S/PDIFはゲートウェアでデコード。
    signal audio_mclk
    signal audio_bck
    signal audio_lrck
    xo_audio = new Xo12M288
    xo_audio.vcc ~ p3v3_io.hv
    xo_audio.en ~ p3v3_io.hv
    xo_audio.gnd ~ gnd
    xo_audio.out ~ audio_mclk
    c_xo_audio = new C100nF_0402
    xo_audio.vcc ~> c_xo_audio ~> gnd

    # オーディオアナログ5V(ビーズでデジタル5Vから分離)
    p5v_audio = new ElectricPower
    p5v_audio.lv ~ gnd
    fb_audio = new FerriteBead
    power_5v.hv ~ fb_audio.p1
    fb_audio.p2 ~ p5v_audio.hv
    c_5va = new C10uF_0805
    p5v_audio.hv ~> c_5va ~> gnd

    # ADC A: D-SUB15の音声(ピン4=L, ピン11=R と仮定)。SJ2/SJ3で切り離し可能
    # (DDC/ID結線のある一般VGAケーブルを挿す場合は開ける)
    adc_dsub = new AudioAdc
    adc_dsub.gnd ~ gnd
    adc_dsub.power_5va ~ p5v_audio
    adc_dsub.power_3v3 ~ p3v3_io
    # X68000のD-SUB15はpin10=AUDIO-L, pin11=AUDIO-R。SJで切離し可(LINE入力優先時等)
    sj_aud_l = new SolderJumper
    sj_aud_r = new SolderJumper
    vga.audio_l ~ sj_aud_l.a   # DSUB15 pin10
    sj_aud_l.b ~ adc_dsub.in_l
    vga.audio_r ~ sj_aud_r.a   # DSUB15 pin11
    sj_aud_r.b ~ adc_dsub.in_r

    # ADC B: 基板上の3.5mmステレオLINE入力
    adc_line = new AudioAdc
    adc_line.gnd ~ gnd
    adc_line.power_5va ~ p5v_audio
    adc_line.power_3v3 ~ p3v3_io
    jack_line = new AudioJack35
    jack_line.sleeve ~ gnd
    jack_line.tip ~ adc_line.in_l
    jack_line.ring ~ adc_line.in_r

    # 音声入力のESD(4ライン: DSUB音声L/R + LINE L/R)
    esd_audio = new EsdArray4
    esd_audio.gnd ~ gnd
    adc_dsub.in_l ~ esd_audio.io1
    adc_dsub.in_r ~ esd_audio.io2
    jack_line.tip ~ esd_audio.io3
    jack_line.ring ~ esd_audio.io4

    # I2S共有バス
    audio_mclk ~ adc_dsub.adc.scki
    audio_mclk ~ adc_line.adc.scki
    audio_bck ~ adc_dsub.adc.bck
    audio_bck ~ adc_line.adc.bck
    audio_lrck ~ adc_dsub.adc.lrc
    audio_lrck ~ adc_line.adc.lrc

    # S/PDIF光受信(デコードはFPGA内)
    spdif = new SpdifRxModule
    spdif.vcc ~ p3v3_io.hv
    spdif.gnd ~ gnd
    c_spdif = new C100nF_0402
    spdif.vcc ~> c_spdif ~> gnd

    # --- 音声系をP4に集約(pin128-138, 順序整理) ---
    sodimm.io_e4 ~ spdif.out            # pin128 (E4) S/PDIFビットストリーム
    sodimm.io_f1 ~ audio_mclk           # pin130 (F1=PCLKC6_1, クロック対応)
    sodimm.io_f3 ~ audio_bck            # pin132 (F3) FPGA出力
    sodimm.io_g3 ~ audio_lrck           # pin134 (G3) FPGA出力
    sodimm.io_h3 ~ adc_dsub.adc.dout    # pin136 (H3) I2S DOUT(DSUB音声)
    sodimm.io_h4 ~ adc_line.adc.dout    # pin138 (H4) I2S DOUT(LINE入力)

    # --- ArgusX(RGBセレクタ)制御コネクタ: I2CバスをTVP7002と共有 ---
    j11_argus = new HeaderArgus
    j11_argus.p3v3 ~ p3v3_io.hv
    j11_argus.gnd ~ gnd
    j11_argus.sda ~ tvp.sda
    j11_argus.scl ~ tvp.scl

    # --- ステータス表示用 SSD1306 I2C OLED(128x64)ヘッダ ---
    # I2CバスをTVP7002と共有(OLED既定0x3C, TVP0x5C/EEPROM0x50-51と非衝突)。
    # 描画はゲートウェア側(I2Cマスタ + SSD1306ドライバ)で実装。ピン順 GND/VDD/SCK/SDA。
    j_oled = new HeaderOled
    j_oled.gnd ~ gnd
    j_oled.vdd ~ p3v3_io.hv
    j_oled.scl ~ tvp.scl
    j_oled.sda ~ tvp.sda

    # --- MACアドレスEEPROM(EUI-48) ×2: ETH0用=0x50, ETH1(将来の2ポート化)用=0x51 ---
    # グローバル一意MACにより複数台運用・2ポートストライピングで衝突管理が不要になる。
    # 空き領域は個体設定の保存に使用(SPIフラッシュ設定ページ計画を置き換え)。
    # I2CはTVP7002(0x5C)と共有。ArgusX側は0x50-0x53を避けること。
    eeprom_mac0 = new Eeprom24aa025e48
    eeprom_mac1 = new Eeprom24aa025e48
    eeprom_mac1.a0 ~ p3v3_io.hv     # 0x51
    eeprom_mac0.a0 ~ gnd            # 0x50
    dec_eeprom = new C100nF_0402[2]
    eeprom_mac0.vcc ~> dec_eeprom[0] ~> gnd
    eeprom_mac1.vcc ~> dec_eeprom[1] ~> gnd
    eeprom_mac0.vcc ~ p3v3_io.hv
    eeprom_mac1.vcc ~ p3v3_io.hv
    eeprom_mac0.vss ~ gnd
    eeprom_mac1.vss ~ gnd
    eeprom_mac0.a1 ~ gnd
    eeprom_mac0.a2 ~ gnd
    eeprom_mac1.a1 ~ gnd
    eeprom_mac1.a2 ~ gnd
    eeprom_mac0.wp ~ gnd            # 設定領域への書込みを許可(MAC領域は保護済み)
    eeprom_mac1.wp ~ gnd
    eeprom_mac0.sda ~ tvp.sda
    eeprom_mac0.scl ~ tvp.scl
    eeprom_mac1.sda ~ tvp.sda
    eeprom_mac1.scl ~ tvp.scl

    # --- GbE出口 (SO-DIMM -> MagJack ×2) ---
    eth = new EthernetPort
    eth.gnd ~ gnd
    eth.chassis.override_net_name = "chassis"
    # ETH2 = PHY0 = litex eth1(映像ストリーム既定, gatewareはeth1を要求)→ jack
    eth.eth2_1_P ~ sodimm.eth2_1_P
    eth.eth2_1_N ~ sodimm.eth2_1_N
    eth.eth2_2_P ~ sodimm.eth2_2_P
    eth.eth2_2_N ~ sodimm.eth2_2_N
    eth.eth2_3_P ~ sodimm.eth2_3_P
    eth.eth2_3_N ~ sodimm.eth2_3_N
    eth.eth2_4_P ~ sodimm.eth2_4_P
    eth.eth2_4_N ~ sodimm.eth2_4_N
    # ETH1 = PHY1 = litex eth0(デュアルリンク/将来用)→ jack2
    eth.eth1_1_P ~ sodimm.eth1_1_P
    eth.eth1_1_N ~ sodimm.eth1_1_N
    eth.eth1_2_P ~ sodimm.eth1_2_P
    eth.eth1_2_N ~ sodimm.eth1_2_N
    eth.eth1_3_P ~ sodimm.eth1_3_P
    eth.eth1_3_N ~ sodimm.eth1_3_N
    eth.eth1_4_P ~ sodimm.eth1_4_P
    eth.eth1_4_N ~ sodimm.eth1_4_N
    # リンクLED制御(FPGA GPIO → MagJack緑/黄)
    eth.led_g_drive ~ sodimm.io_r1    # ETH2 緑LED (P6 pin42)
    eth.led_y_drive ~ sodimm.io_t1    # ETH2 黄LED (P6 pin44)
    eth.led_g_drive2 ~ sodimm.io_u1   # ETH1 緑LED (P6 pin46)
    eth.led_y_drive2 ~ sodimm.io_y2   # ETH1 黄LED (P6 pin48)
    # LED駆動ネットに読める名前を付与(自動名が pin番号 50/52 等になるのを回避)
    eth.led_g_drive.override_net_name = "eth2_led_g"
    eth.led_y_drive.override_net_name = "eth2_led_y"
    eth.led_g_drive2.override_net_name = "eth1_led_g"
    eth.led_y_drive2.override_net_name = "eth1_led_y"

    # =========================================================================
    # ネット名の明示化(PCBレイアウトでの判別性向上)
    # -------------------------------------------------------------------------
    # atopileは名前付きtop-level signalが無いネットを、繋がるパッシブの
    # power(hv/lv)疑似IFやピン番号から自動命名する(例: c_ac-power-hv, "45")。
    # 機能上重要なネットはoverride_net_nameで固定名を与え、レイアウト時に
    # 追跡できるようにする(gnd/jtag_tck/chassisと同じ流儀)。
    # =========================================================================

    # --- アナログRGB: 入力(コネクタ側)/ 出力(TVP AC結合後)/ SOG ---
    ch_r.input.override_net_name = "vin_r"
    ch_g.input.override_net_name = "vin_g"
    ch_b.input.override_net_name = "vin_b"
    ch_r.output.override_net_name = "rin3"
    ch_g.output.override_net_name = "gin3"
    ch_b.output.override_net_name = "bin3"
    tvp.sogin_3.override_net_name = "sogin3"

    # --- TVP アナログ電源(フェライトビーズ後段: star接続の起点) ---
    tvp.avdd.override_net_name = "avdd"
    tvp.pll_avdd.override_net_name = "pll_avdd"

    # --- H-PLL ループフィルタ ---
    tvp.filt1.override_net_name = "pll_filt1"
    tvp.filt2.override_net_name = "pll_filt2"
    tvp.pll_f.override_net_name = "pll_f"
    filt_mid.override_net_name = "pll_filt_mid"

    # --- 同期系(自動名がcap名/pin名に化けるネット) ---
    vs_delayed.override_net_name = "vsync_delayed"
    tvp.vsync_a.override_net_name = "vsync_a"

    # --- デジタル映像バス TVP出力 → SO-DIMM(自動名が数値になるのを回避) ---
    # 実装は [9:2] の8bit/色(b0/b1/r0/r1/g0/g1は未結線)。vd_ プレフィクスで
    # 並列バスとして一括grep/長さ整合しやすくする。
    tvp.r9.override_net_name = "vd_r9"
    tvp.r8.override_net_name = "vd_r8"
    tvp.r7.override_net_name = "vd_r7"
    tvp.r6.override_net_name = "vd_r6"
    tvp.r5.override_net_name = "vd_r5"
    tvp.r4.override_net_name = "vd_r4"
    tvp.r3.override_net_name = "vd_r3"
    tvp.r2.override_net_name = "vd_r2"
    tvp.g9.override_net_name = "vd_g9"
    tvp.g8.override_net_name = "vd_g8"
    tvp.g7.override_net_name = "vd_g7"
    tvp.g6.override_net_name = "vd_g6"
    tvp.g5.override_net_name = "vd_g5"
    tvp.g4.override_net_name = "vd_g4"
    tvp.g3.override_net_name = "vd_g3"
    tvp.g2.override_net_name = "vd_g2"
    tvp.b9.override_net_name = "vd_b9"
    tvp.b8.override_net_name = "vd_b8"
    tvp.b7.override_net_name = "vd_b7"
    tvp.b6.override_net_name = "vd_b6"
    tvp.b5.override_net_name = "vd_b5"
    tvp.b4.override_net_name = "vd_b4"
    tvp.b3.override_net_name = "vd_b3"
    tvp.b2.override_net_name = "vd_b2"

    # --- 音声: アナログ入力 / I2S DOUT ---
    adc_dsub.in_l.override_net_name = "aud_dsub_l"
    adc_dsub.in_r.override_net_name = "aud_dsub_r"
    adc_line.in_l.override_net_name = "aud_line_l"
    adc_line.in_r.override_net_name = "aud_line_r"
    adc_dsub.adc.vinl.override_net_name = "aud_dsub_l_ac"
    adc_dsub.adc.vinr.override_net_name = "aud_dsub_r_ac"
    adc_line.adc.vinl.override_net_name = "aud_line_l_ac"
    adc_line.adc.vinr.override_net_name = "aud_line_r_ac"
    adc_dsub.adc.dout.override_net_name = "i2s_dout_dsub"
    adc_line.adc.dout.override_net_name = "i2s_dout_line"
    spdif.out.override_net_name = "spdif"
    adc_dsub.adc.vref.override_net_name = "aud_vref_dsub"
    adc_line.adc.vref.override_net_name = "aud_vref_line"

    # --- 未使用アナログ入力の終端(どのピンの終端かを判別可能に) ---
    tvp.rin_1.override_net_name = "rin1_nc"
    tvp.rin_2.override_net_name = "rin2_nc"
    tvp.bin_1.override_net_name = "bin1_nc"
    tvp.bin_2.override_net_name = "bin2_nc"
    tvp.gin_1.override_net_name = "gin1_nc"
    tvp.gin_2.override_net_name = "gin2_nc"
    tvp.gin_4.override_net_name = "gin4_nc"
    tvp.sogin_1.override_net_name = "sogin1_nc"
    tvp.sogin_2.override_net_name = "sogin2_nc"

    gnd.override_net_name = "gnd"
