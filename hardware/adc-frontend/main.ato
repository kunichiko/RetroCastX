component EsdArray4:
    """ROHM EMZT6.8ET2R A-Common Quad ESD array. EMT6 (SOT-563 6-pin). LCSC: C510333

    4ラインESD保護(4 I/O + 共通ノード)。映像/同期/音声入力の保護に使用。
    ピンアウトは6ピン共通ノードアレイの標準配置(下段1-2-3/上段6-5-4、
    四隅1/3/4/6=I/O、中央2/5=共通)を採用。4chとも等価なのでI/O割当順は任意。
    ★発注前にROHM EMZT6.8ET2Rデータシートで共通ノード位置(pin2/5)を要確認。
    """
    trait is_atomic_part<manufacturer="ROHM", partnumber="EMZT6.8ET2R", footprint="parts/ROHM_EMZT6_8ET2R/EMT6_L1.6-W1.2-P0.50-LS1.6-BL.kicad_mod", symbol="parts/ROHM_EMZT6_8ET2R/EMZT6.8ET2R.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C510333", manufacturer="ROHM", partno="EMZT6.8ET2R">
    trait has_designator_prefix<prefix="D">
    signal io1 ~ pin 1
    signal io2 ~ pin 3
    signal io3 ~ pin 4
    signal io4 ~ pin 6
    signal gnd ~ pin 2
    gnd ~ pin 5


