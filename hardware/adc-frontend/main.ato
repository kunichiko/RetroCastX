    signal a1 ~ pin 2
    signal a2 ~ pin 3
    signal vss ~ pin 4
    signal sda ~ pin 5
    signal scl ~ pin 6
    signal wp ~ pin 7
    signal vcc ~ pin 8


component DigitalRgbConnector:
    """デジタルRGB(TTL)入力コネクタ: 1.25mmピッチ 単列8極、右アングルSMD。
    YIYUAN YTC-A1251-08ABW(A1251/PicoBlade互換系)。LCSC: C7436577

    ピン配置(ピッチ1.25mm、pad9/10=取付タブ):
      1=GND  2=R  3=G  4=B  5=I(輝度)  6=HS  7=VS  8=GND   9,10=取付タブ→GND

    **信号の並びを R/G/B/I → HS/VS の自然な順にしている**(2026-08-11 変更)。
    以前は「フレーム全体を壊すのは同期なので HS/VS を GND の隣に置く」という理由で
    1=GND 2=HS 3=R…7=VS としていたが、変換ケーブルを自作する前提だと**並びの
    分かりやすさ(取り違え防止)の方が実利が大きい**と判断して並べ替えた。
    8極では信号6本+GND2本しか取れないので、GNDは両端(1と8)のみ。この順では
    VS(7)はGND(8)に隣接するが、HS(6)は I(5) と VS(7) に挟まれてGNDに隣接しない。
    ケーブルが長くノイズが出る場合は同シリーズの10極(GNDを1本おきに配置)へ
    差し替えられる(フットプリント変更のみ)。

    ★取付タブ(pad9/10)は機械保持用。GNDへ落として実装強度と静電的な安定を得る。
    ★JLCの実装ライブラリ収載は未確認。実装対象外になる場合は手はんだで対応可
      (0.8mmパッド・1.25mmピッチなので難しくない)。
    """
    trait is_atomic_part<manufacturer="YIYUAN", partnumber="YTC-A1251-08ABW", footprint="parts/YIYUAN_YTC_A1251_08ABW/CONN-SMD_8P-P1.25_YTC-A1251-08ABW.kicad_mod", symbol="parts/YIYUAN_YTC_A1251_08ABW/YTC-A1251-08ABW.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C7436577", manufacturer="YIYUAN", partno="YTC-A1251-08ABW">
    trait has_designator_prefix<prefix="J">
    signal gnd ~ pin 1
    signal r ~ pin 2
    signal g ~ pin 3
    signal b ~ pin 4
    signal intensity ~ pin 5
    signal hs ~ pin 6
    signal vs ~ pin 7
    gnd ~ pin 8
    gnd ~ pin 9    # 取付タブ
    gnd ~ pin 10   # 取付タブ


