component EsdArray4:
    """ROHM EMZT6.8ET2R A-Common Quad ESD array. EMT6 (SOT-563 6-pin). LCSC: C510333

    4ラインESD保護(4 I/O + 共通ノード)。映像/同期/音声入力の保護に使用。
    ピンアウトは6ピン共通ノードアレイの標準配置(下段1-2-3/上段6-5-4、
    四隅1/3/4/6=I/O、中央2/5=共通)を採用。4chとも等価なのでI/O割当順は任意。
    ★発注前にROHM EMZT6.8ET2Rデータシートで共通ノード位置(pin2/5)を要確認。
    """
    trait is_atomic_part<manufacturer="ROHM", partnumber="EMZT6.8ET2R", footprint="parts/ROHM_EMZT6_8ET2R/EMT6_L1.6-W1.2-P0.50-LS1.6-BL.kicad_mod", symbol="parts/ROHM_EMZT6_8ET2R/EMZT6.8ET2R.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C510333", manufacturer="ROHM", partno="EMZT6.8ET2R">
    trait has_designator_prefix<prefix="D">
    signal io1 ~ pin 1
    signal io2 ~ pin 3
    signal io3 ~ pin 4
    signal io4 ~ pin 6
    signal gnd ~ pin 2
    gnd ~ pin 5


component Osc27M:
    """YXC 27MHz 3.3V CMOS アクティブ発振器, SMD3225-4P。LCSC: C725995

    EXT_CLKは単線クロック入力なのでアクティブ発振器で駆動する(旧: 誤って水晶C9008を
    選定していたのを修正)。ピン: 1=Tri-state(EN, VDDへ) 2=GND 3=OUT 4=VDD。
    """
    trait is_atomic_part<manufacturer="YXC", partnumber="OT322527MJBA4SL", footprint="parts/YXC_OT322527MJBA4SL/OSC-SMD_4P-L3.2-W2.5-BL.kicad_mod", symbol="parts/YXC_OT322527MJBA4SL/OT322527MJBA4SL.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C725995", manufacturer="YXC", partno="OT322527MJBA4SL">
    trait has_designator_prefix<prefix="X">
    signal en ~ pin 1     # Tri-state(出力イネーブル): VDDでイネーブル
    signal gnd ~ pin 2
    signal out ~ pin 3
    signal vcc ~ pin 4


component Dsub15X68k:
    """X68000等 日本式アナログRGB 15ピン(2列 DA-15)メス。音声L/R含む。
    CONNFLY DS1037-15FNAKT76-0CC (右アングルPCBマウント)。LCSC: C77836

    ピン配置(ohnaka提供・X68000):
    1=R-OUT 2=R-GND 3=G-OUT 4=G-GND 5=B-OUT 6=B-GND 7=YS(データ有無status)
    8=GND 9=N.C 10=AUDIO-L 11=AUDIO-R 12=GND 13=N.C 14=H-SYNC 15=V-SYNC
    RGBと各GNDが交互配置。旧VGA(3列HD-15/DDC)とは全くの別物。
    """
    trait is_atomic_part<manufacturer="CONNFLY", partnumber="DS1037-15FNAKT76-0CC", footprint="parts/CONNFLY_DS1037_15FNAKT76_0CC/DSUB-TH_DS1037-15FNAKT74-0CC.kicad_mod", symbol="parts/CONNFLY_DS1037_15FNAKT76_0CC/DS1037-15FNAKT76-0CC.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C77836", manufacturer="CONNFLY", partno="DS1037-15FNAKT76-0CC">
    trait has_designator_prefix<prefix="J">
    signal r ~ pin 1
    signal r_gnd ~ pin 2
    signal g ~ pin 3
    signal g_gnd ~ pin 4
    signal b ~ pin 5
    signal b_gnd ~ pin 6
    signal ys ~ pin 7        # データ有無status(X68000)。今回は未使用
    signal gnd ~ pin 8
    gnd ~ pin 12
    signal audio_l ~ pin 10
    signal audio_r ~ pin 11
    signal hsync ~ pin 14
    signal vsync ~ pin 15
    signal shield ~ pin 16   # シェル/固定
    shield ~ pin 17
    # pin 9, 13 = N.C(未接続)


component Pcm1808:
    """TI PCM1808 stereo audio ADC (24bit ΔΣ, I2S/スレーブ動作), TSSOP-14。

    LCSC: 要選定(PCM1808PWR)。
    注意: ピン番号は仮割り当て。フットプリント取り込み後にデータシート(SLES177)と必ず照合。
    """
    trait is_atomic_part<manufacturer="TI", partnumber="PCM1808PWR", footprint="parts/TI_PCM1808PWR/TSSOP-14_L5.0-W4.4-P0.65-LS6.4-BL.kicad_mod", symbol="parts/TI_PCM1808PWR/PCM1808PWR.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C55513", manufacturer="TI", partno="PCM1808PWR">
    trait has_designator_prefix<prefix="U">
    signal scki ~ pin 1    # システムクロック(256/384/512fs, スレーブ時自動判別)
    signal bck ~ pin 2     # ビットクロック(64fs)
    signal lrc ~ pin 3     # LRクロック(fs)
    signal dgnd ~ pin 4
    signal vdd ~ pin 5     # デジタル3.3V
    signal dout ~ pin 6    # I2Sデータ出力
    signal fmt ~ pin 7     # 0=I2S
    signal md1 ~ pin 8     # MD1:MD0=00 でスレーブ
    signal md0 ~ pin 9
    signal vcc ~ pin 10    # アナログ5V
    signal agnd ~ pin 11
    signal vref ~ pin 12   # 基準電圧デカップリング
    signal vinr ~ pin 13
    signal vinl ~ pin 14


