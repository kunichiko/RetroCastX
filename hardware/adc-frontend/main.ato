#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

import ElectricPower
import Resistor
import Capacitor

# =============================================================================
# RetroCastX ADC front-end: TVP7002 breakout for Colorlight i5 EXT board
#
# Retro PC analog RGB (VGA HD-15) -> TVP7002 (triple ADC + H-PLL) ->
# 24bit parallel + DATACLK/HSOUT/VSOUT/SOGOUT -> PMOD-style 2x6 headers.
#
# 回路の根拠:
#  - TI TVP7002 datasheet SLES206C(電源系統・PLLフィルタ・入力終端)
#  - OSSC rev1.8 (marqs85/ossc_pcb) の実機BOM(同期系・ESD・フェライト)
# =============================================================================


# --- Parts (footprints: VS Code上で `ato create part` により後付けする) -----

component Tvp7002:
    """TI TVP7002 triple 8/10-bit 165/110MSPS video digitizer w/ H-PLL.

    HTQFP-100 (PZP). LCSC: C3824085 / DigiKey: TVP7002PZPR
    """

    # Analog inputs
    signal sogin_1 ~ pin 1
    signal gin_1 ~ pin 2
    signal rin_3 ~ pin 9
    signal rin_2 ~ pin 10
    signal rin_1 ~ pin 11
    signal bin_3 ~ pin 16
    signal bin_2 ~ pin 17
    signal bin_1 ~ pin 18
    signal gin_4 ~ pin 96
    signal sogin_3 ~ pin 97
    signal gin_3 ~ pin 98
    signal sogin_2 ~ pin 99
    signal gin_2 ~ pin 100

    # Power: A33VDD (analog 3.3V)
    signal a33vdd ~ pin 13
    a33vdd ~ pin 14
    a33vdd ~ pin 93
    a33vdd ~ pin 94
    signal a33gnd ~ pin 12
    a33gnd ~ pin 15
    a33gnd ~ pin 92
    a33gnd ~ pin 95

    # Power: AVDD (analog core 1.9V)
    signal avdd ~ pin 4
    avdd ~ pin 6
    avdd ~ pin 7
    avdd ~ pin 19
    signal agnd ~ pin 3
    agnd ~ pin 5
    agnd ~ pin 8
    agnd ~ pin 20

    # Power: PLL AVDD (1.9V)
    signal pll_avdd ~ pin 84
    pll_avdd ~ pin 85
    signal pll_agnd ~ pin 83
    pll_agnd ~ pin 86
    pll_agnd ~ pin 90

    # Power: DVDD (digital core 1.9V)
    signal dvdd ~ pin 39
    dvdd ~ pin 69
    signal dgnd ~ pin 40
    dgnd ~ pin 68

    # Power: IOVDD (output drivers 3.3V)
    signal iovdd ~ pin 26
    iovdd ~ pin 41
    iovdd ~ pin 53
    iovdd ~ pin 66
    signal iognd ~ pin 27
    iognd ~ pin 42
    iognd ~ pin 54
    iognd ~ pin 60
    iognd ~ pin 67

    # Substrate -> analog ground
    signal nsub ~ pin 21
    nsub ~ pin 91

    # Digital video outputs (B/G/R 10bit each, MSB=_9)
    signal b0 ~ pin 29
    signal b1 ~ pin 30
    signal b2 ~ pin 31
    signal b3 ~ pin 32
    signal b4 ~ pin 33
    signal b5 ~ pin 34
    signal b6 ~ pin 35
    signal b7 ~ pin 36
    signal b8 ~ pin 37
    signal b9 ~ pin 38
    signal g0 ~ pin 43
    signal g1 ~ pin 44
    signal g2 ~ pin 45
    signal g3 ~ pin 46
    signal g4 ~ pin 47
    signal g5 ~ pin 48
    signal g6 ~ pin 49
    signal g7 ~ pin 50
    signal g8 ~ pin 51
    signal g9 ~ pin 52
    signal r0 ~ pin 55
    signal r1 ~ pin 56
    signal r2 ~ pin 57
    signal r3 ~ pin 58
    signal r4 ~ pin 59
    signal r5 ~ pin 61
    signal r6 ~ pin 62
    signal r7 ~ pin 63
    signal r8 ~ pin 64
    signal r9 ~ pin 65

    # Timing / status outputs
    signal fidout ~ pin 22
    signal vsout ~ pin 23
    signal hsout ~ pin 24
    signal sogout ~ pin 25
    signal dataclk ~ pin 28

    # Control
    signal pwdn ~ pin 70
    signal resetb ~ pin 71
    signal tms ~ pin 72
    signal i2ca ~ pin 73
    signal scl ~ pin 74
    signal sda ~ pin 75
    signal clamp ~ pin 76
    signal coast ~ pin 77

    # Sync inputs / ext clock
    signal vsync_a ~ pin 78
    signal vsync_b ~ pin 79
    signal ext_clk ~ pin 80
    signal hsync_a ~ pin 81
    signal hsync_b ~ pin 82

    # H-PLL loop filter
    signal filt1 ~ pin 87
    signal filt2 ~ pin 88
    signal pll_f ~ pin 89


component Lvc2g17:
    """TI SN74LVC2G17 dual Schmitt-trigger buffer (5V-tolerant inputs).

    SOT-23-6. LCSC: C10429
    """
    signal in_a ~ pin 1
    signal gnd ~ pin 2
    signal in_b ~ pin 3
    signal out_b ~ pin 4
    signal vcc ~ pin 5
    signal out_a ~ pin 6


component Az1117Fixed33:
    """Diodes AZ1117H-3.3 LDO 800mA, SOT-223. LCSC: C92517"""
    signal gnd ~ pin 1
    signal out ~ pin 2
    signal vin ~ pin 3
    out ~ pin 4  # tab


component Az1117Adj:
    """Diodes AZ1117H-ADJ LDO 800mA (Vref=1.25V), SOT-223. LCSC: C92103"""
    signal adj ~ pin 1
    signal out ~ pin 2
    signal vin ~ pin 3
    out ~ pin 4  # tab


component Tlv70019:
    """TI TLV70019 1.9V 200mA LDO, SOT-23-5. LCSC: C2862411"""
    signal vin ~ pin 1
    signal gnd ~ pin 2
    signal en ~ pin 3
    signal out ~ pin 5


component FerriteBead:
    """TDK MPZ1608S221A 220ohm@100MHz, 0603. LCSC: C76815"""
    signal p1 ~ pin 1
    signal p2 ~ pin 2


component EsdArray4:
    """Nexperia PESD5V0U4BW-compatible quad ESD array (low-cap, for video).

    SOT-553. LCSC: C5182054
    """
    signal io1 ~ pin 1
    signal io2 ~ pin 2
    signal gnd ~ pin 3
    signal io3 ~ pin 4
    signal io4 ~ pin 5


component Osc27M:
    """YXC 27MHz 3.3V CMOS oscillator, SMD3225-4P. LCSC: C9008"""
    signal en ~ pin 1
    signal gnd ~ pin 2
    signal out ~ pin 3
    signal vcc ~ pin 4


component VgaConnector:
    """HD-15 (3-row D-sub 15) female VGA connector. LCSC: C138387"""
    signal red ~ pin 1
    signal green ~ pin 2
    signal blue ~ pin 3
    signal id2 ~ pin 4
    signal gnd ~ pin 5
    signal red_rtn ~ pin 6
    signal green_rtn ~ pin 7
    signal blue_rtn ~ pin 8
    signal key ~ pin 9
    signal sync_gnd ~ pin 10
    signal id0 ~ pin 11
    signal sda ~ pin 12
    signal hsync ~ pin 13
    signal vsync ~ pin 14
    signal scl ~ pin 15
    signal shield ~ pin 16


component HeaderExtP2:
    """EXTボード P2 を1対1ミラーする 2×15 ヘッダ(GPIO 20本)。

    信号名はECP5(BG381)のボール名。ピン番号は wuxx pinout 図の並び
    (左→右、奇数=外側列)を仮定 — レイアウト時に実基板と要照合。
    """
    signal io_j20 ~ pin 1
    signal io_g20 ~ pin 2
    signal io_l18 ~ pin 3
    signal io_k20 ~ pin 4
    signal io_m18 ~ pin 5
    signal io_l20 ~ pin 6
    signal io_n17 ~ pin 7
    signal io_n18 ~ pin 8
    signal gnd ~ pin 9
    gnd ~ pin 10
    signal p3v3_ext ~ pin 11
    p3v3_ext ~ pin 12
    signal io_u17 ~ pin 13
    signal io_p18 ~ pin 14
    signal p5v_ext ~ pin 15
    gnd ~ pin 16
    signal io_t17 ~ pin 17
    signal io_u18 ~ pin 18
    signal io_p17 ~ pin 19
    signal io_m17 ~ pin 20
    signal io_r18 ~ pin 21
    signal io_r17 ~ pin 22
    signal io_c18 ~ pin 23
    signal io_t18 ~ pin 24
    signal io_u16 ~ pin 25
    signal io_k18 ~ pin 26
    gnd ~ pin 27
    gnd ~ pin 28
    p3v3_ext ~ pin 29
    p3v3_ext ~ pin 30


component HeaderExtP4:
    """EXTボード P4 を1対1ミラーする 2×15 ヘッダ(GPIO 18本)。

    PCLK対応ボール: F2(PCLKT7_0), F1(PCLKC6_1), F3(PCLKC7_1),
    G3(PCLKT7_1), H4(GR_PCLK7_1) — DATACLKはF2へ。
    """
    signal p3v3_ext ~ pin 1
    p3v3_ext ~ pin 2
    signal gnd ~ pin 3
    gnd ~ pin 4
    signal io_e1 ~ pin 5
    signal io_f2 ~ pin 6
    signal io_e4 ~ pin 7
    signal io_f1 ~ pin 8
    signal io_f3 ~ pin 9
    signal io_g3 ~ pin 10
    signal io_h3 ~ pin 11
    signal io_h4 ~ pin 12
    signal io_h5 ~ pin 13
    signal io_j4 ~ pin 14
    gnd ~ pin 15
    signal p5v_ext ~ pin 16
    signal io_j5 ~ pin 17
    signal io_k3 ~ pin 18
    p3v3_ext ~ pin 19
    p3v3_ext ~ pin 20
    gnd ~ pin 21
    gnd ~ pin 22
    signal io_a2 ~ pin 23
    signal io_k5 ~ pin 24
    signal io_k4 ~ pin 25
    signal io_b3 ~ pin 26
    signal io_b2 ~ pin 27
    signal io_e19 ~ pin 28
    signal nc29 ~ pin 29
    signal nc30 ~ pin 30


component DcJack:
    """DC005 barrel jack (5V in)。EXT給電運用時は未実装可。LCSC: C431533"""
    signal center ~ pin 1
    signal sleeve ~ pin 2
    signal switch ~ pin 3


component SolderJumper:
    """はんだジャンパ(2パッド)。フットプリントはKiCad標準 SolderJumper-2 を想定。"""
    signal a ~ pin 1
    signal b ~ pin 2


component UsbCPowerReceptacle:
    """USB-C レセプタクル(USB2.0 16pin級)、電源入力用。TYPE-C-31-M-12 想定。LCSC: C165948

    注意: ピン番号は仮割り当て。フットプリント取り込み後にデータシートと必ず照合。
    """
    signal gnd ~ pin 1
    signal vbus ~ pin 2
    signal cc1 ~ pin 5
    signal dp ~ pin 6
    signal dn ~ pin 7
    signal sbu1 ~ pin 8
    signal sbu2 ~ pin 9
    signal cc2 ~ pin 12
    vbus ~ pin 15
    gnd ~ pin 16
    signal shell ~ pin 17
    shell ~ pin 18


component GbeMagJack:
    """1000BASE-T MagJack(トランス・チョーク・Bob-Smith内蔵RJ45)。

    HanRun HR911130A 想定。LCSC: C54408
    注意: ピン番号は仮割り当て。フットプリント取り込み後にデータシートと必ず照合。
    """
    signal mdi0_p ~ pin 1
    signal mdi0_ct ~ pin 2
    signal mdi0_n ~ pin 3
    signal mdi1_p ~ pin 4
    signal mdi1_ct ~ pin 5
    signal mdi1_n ~ pin 6
    signal mdi2_p ~ pin 7
    signal mdi2_ct ~ pin 8
    signal mdi2_n ~ pin 9
    signal mdi3_p ~ pin 10
    signal mdi3_ct ~ pin 11
    signal mdi3_n ~ pin 12
    signal led_g_a ~ pin 13
    signal led_g_k ~ pin 14
    signal led_y_a ~ pin 15
    signal led_y_k ~ pin 16
    signal shield ~ pin 17
    shield ~ pin 18


component HeaderP1:
    """EXTボード P1 と1対1対応の 2×15 ヘッダ(GbE差動ペア受け)。

    汎用2.54mmピンヘッダ 2×15(2×40の切断可)。ピン配置は
    kazkojima i5ether / wuxx pinout 図で確定した EXT P1 実配置に一致。
    """
    signal p3v3 ~ pin 1
    p3v3 ~ pin 2
    signal gnd ~ pin 3
    gnd ~ pin 4
    signal eth2_2p ~ pin 5
    signal eth2_4p ~ pin 6
    signal eth2_2n ~ pin 7
    signal eth2_4n ~ pin 8
    signal eth2_1n ~ pin 9
    signal eth2_3n ~ pin 10
    signal eth2_1p ~ pin 11
    signal eth2_3p ~ pin 12
    signal nc13 ~ pin 13
    signal nc14 ~ pin 14
    signal p5v ~ pin 15
    gnd ~ pin 16
    signal nc17 ~ pin 17
    signal nc18 ~ pin 18
    p3v3 ~ pin 19
    p3v3 ~ pin 20
    gnd ~ pin 21
    gnd ~ pin 22
    signal eth1_1p ~ pin 23
    signal eth1_3p ~ pin 24
    signal eth1_1n ~ pin 25
    signal eth1_3n ~ pin 26
    signal eth1_2n ~ pin 27
    signal eth1_4n ~ pin 28
    signal eth1_2p ~ pin 29
    signal eth1_4p ~ pin 30


# --- Sub-circuits ------------------------------------------------------------

module VideoInputChannel:
    """1ch分のアナログ入力段: 75Ω終端 -> 100nF ACカップリング -> TVP入力。"""
    signal input
    signal output
    power = new ElectricPower  # 終端のグラウンド基準

    r_term = new Resistor
    r_term.resistance = 75ohm +/- 1%
    r_term.package = "0402"
    input ~> r_term ~> power.lv

    c_ac = new Capacitor
    c_ac.capacitance = 100nF +/- 10%
    c_ac.package = "0402"
    input ~> c_ac ~> output


module PowerTree:
    """5V入力 -> 3.3V(IO/デジタル) + 3.3V(アナログ) + 1.9V(AVDD/PLL) + 1.9V(DVDD)。

    OSSCの電源系を簡略化した構成。AVDD系はAZ1117H-ADJ(分圧で1.9V)を5Vから
    直接落とす(損失~0.9W: SOT-223 + 銅箔ベタで放熱すること)。
    """
    power_5v = new ElectricPower
    p3v3_io = new ElectricPower
    p3v3_a = new ElectricPower
    p1v9_a = new ElectricPower
    p1v9_d = new ElectricPower

    ldo_io = new Az1117Fixed33
    ldo_a33 = new Az1117Fixed33
    ldo_a19 = new Az1117Adj
    ldo_d19 = new Tlv70019

    # 共通GND
    signal gnd
    gnd ~ power_5v.lv
    gnd ~ p3v3_io.lv
    gnd ~ p3v3_a.lv
    gnd ~ p1v9_a.lv
    gnd ~ p1v9_d.lv
    gnd ~ ldo_io.gnd
    gnd ~ ldo_a33.gnd
    gnd ~ ldo_d19.gnd

    ldo_io.vin ~ power_5v.hv
    ldo_io.out ~ p3v3_io.hv
    ldo_a33.vin ~ power_5v.hv
    ldo_a33.out ~ p3v3_a.hv
    ldo_a19.vin ~ power_5v.hv
    ldo_a19.out ~ p1v9_a.hv
    ldo_d19.vin ~ p3v3_io.hv
    ldo_d19.en ~ p3v3_io.hv
    ldo_d19.out ~ p1v9_d.hv

    # AZ1117-ADJ 分圧: Vout = 1.25 * (1 + R2/R1) = 1.25 * (1 + 62/120) ≈ 1.896V
    r_fb_top = new Resistor  # OUT -> ADJ
    r_fb_top.resistance = 120ohm +/- 1%
    r_fb_top.package = "0402"
    r_fb_bot = new Resistor  # ADJ -> GND
    r_fb_bot.resistance = 62ohm +/- 1%
    r_fb_bot.package = "0402"
    ldo_a19.out ~> r_fb_top ~> ldo_a19.adj
    ldo_a19.adj ~> r_fb_bot ~> gnd

    # 入出力バルクコンデンサ(AZ1117は出力に≥10µFのESR安定性要求あり)
    bulk_caps = new Capacitor[5]
    for c in bulk_caps:
        c.capacitance = 10uF +/- 20%
        c.package = "0805"
    power_5v.hv ~> bulk_caps[0] ~> gnd
    p3v3_io.hv ~> bulk_caps[1] ~> gnd
    p3v3_a.hv ~> bulk_caps[2] ~> gnd
    p1v9_a.hv ~> bulk_caps[3] ~> gnd
    p1v9_d.hv ~> bulk_caps[4] ~> gnd

    assert power_5v.voltage within 4.5V to 5.5V


module EthernetPort:
    """GbE出口: EXT P1 の ETH2 側ペア(LiteXデフォルト phy0)を MagJack へ。

    回路は kazkojima 氏 i5ether(1000BASE-T netboot/nfsroot 実績あり)に準拠:
    - MDIペアは PHY から DC結合のまま(直列部品なし)
    - PHY側センタータップ: 各0.1µF→GND のみ(B50612D は内部バイアスで無給電可)
    - Bob-Smith終端(75Ω+1nF)は HR911130A 内蔵
    - 論理GND-シャーシ間: 4.7nF/2kV ×2(1812)
    - ETH1 側ペアは J8 に来ているが未使用(将来の2ポート化用)
    - LED: PHYのLED信号はP1に出ていないため未接続
    """
    signal gnd
    signal chassis
    signal p5v_from_ext  # EXT P1-15の5V。給電に使う場合のみAppで接続(通常は未使用)

    j8 = new HeaderP1
    jack = new GbeMagJack

    j8.gnd ~ gnd
    j8.p5v ~ p5v_from_ext

    j8.eth2_1p ~ jack.mdi0_p
    j8.eth2_1n ~ jack.mdi0_n
    j8.eth2_2p ~ jack.mdi1_p
    j8.eth2_2n ~ jack.mdi1_n
    j8.eth2_3p ~ jack.mdi2_p
    j8.eth2_3n ~ jack.mdi2_n
    j8.eth2_4p ~ jack.mdi3_p
    j8.eth2_4n ~ jack.mdi3_n

    ct_caps = new Capacitor[4]
    for c in ct_caps:
        c.capacitance = 100nF +/- 20%
        c.package = "0402"
    jack.mdi0_ct ~> ct_caps[0] ~> gnd
    jack.mdi1_ct ~> ct_caps[1] ~> gnd
    jack.mdi2_ct ~> ct_caps[2] ~> gnd
    jack.mdi3_ct ~> ct_caps[3] ~> gnd

    jack.shield ~ chassis
    bridge_caps = new Capacitor[2]
    for c in bridge_caps:
        c.capacitance = 4.7nF +/- 20%
        c.package = "1812"
        c.max_voltage = 2000V to 4000V
    chassis ~> bridge_caps[0] ~> gnd
    chassis ~> bridge_caps[1] ~> gnd


# --- Top level ----------------------------------------------------------------

module App:
    tvp = new Tvp7002
    vga = new VgaConnector
    buf_sync = new Lvc2g17
    osc = new Osc27M
    jack = new DcJack
    supply = new PowerTree

    # 電源レール
    power_5v = new ElectricPower
    p3v3_io = new ElectricPower
    p3v3_a = new ElectricPower
    p1v9_a = new ElectricPower
    p1v9_d = new ElectricPower
    power_5v ~ supply.power_5v
    p3v3_io ~ supply.p3v3_io
    p3v3_a ~ supply.p3v3_a
    p1v9_a ~ supply.p1v9_a
    p1v9_d ~ supply.p1v9_d

    signal gnd
    gnd ~ power_5v.lv

    # 5V給電: 本基板が電源マスター(既定)。
    #   J10 USB-C(CCにRd 5.1kΩ実装済み → PD充電器+C-Cケーブルで5V/3A可)から給電し、
    #   SJ1(閉=既定)でヘッダ5Vピン経由でEXTボードへ「逆給電」する。
    #   この運用ではEXTボードのスライドスイッチS1をOFFにし、EXTのUSB-CはJTAG/UARTデータ専用とする
    #   (EXT側USB-CはCC未接続のためC-Cケーブルでは受電できない、という実測済みの制約への対策)。
    #   代替入力: J7 DCジャック。J10とJ7は同時使用不可。
    usbc = new UsbCPowerReceptacle
    usbc.vbus ~ power_5v.hv
    usbc.gnd ~ gnd
    usbc.shell ~ gnd
    r_cc1 = new Resistor
    r_cc1.resistance = 5.1kohm +/- 1%
    r_cc1.package = "0402"
    r_cc2 = new Resistor
    r_cc2.resistance = 5.1kohm +/- 1%
    r_cc2.package = "0402"
    usbc.cc1 ~> r_cc1 ~> gnd
    usbc.cc2 ~> r_cc2 ~> gnd

    signal p5v_ext
    sj_ext5v = new SolderJumper
    p5v_ext ~ sj_ext5v.a
    sj_ext5v.b ~ power_5v.hv
    jack.center ~ power_5v.hv
    jack.sleeve ~ gnd

    power_5v.voltage = 5V +/- 5%
    p3v3_io.voltage = 3.3V +/- 3%
    p3v3_a.voltage = 3.3V +/- 3%
    p1v9_a.voltage = 1.9V +/- 5%
    p1v9_d.voltage = 1.9V +/- 3%
    assert p1v9_a.voltage within 1.8V to 2.0V
    assert p1v9_d.voltage within 1.8V to 2.0V

    # TVP7002 電源接続(AVDD/PLL_AVDDはフェライトビーズで分離)
    fb_avdd = new FerriteBead
    fb_pll = new FerriteBead
    p1v9_a.hv ~ fb_avdd.p1
    fb_avdd.p2 ~ tvp.avdd
    p1v9_a.hv ~ fb_pll.p1
    fb_pll.p2 ~ tvp.pll_avdd

    tvp.a33vdd ~ p3v3_a.hv
    tvp.dvdd ~ p1v9_d.hv
    tvp.iovdd ~ p3v3_io.hv
    tvp.a33gnd ~ gnd
    tvp.agnd ~ gnd
    tvp.pll_agnd ~ gnd
    tvp.dgnd ~ gnd
    tvp.iognd ~ gnd
    tvp.nsub ~ gnd

    # デカップリング(各電源ピン群に100nF)
    dec_caps = new Capacitor[14]
    for c in dec_caps:
        c.capacitance = 100nF +/- 20%
        c.package = "0402"
    tvp.a33vdd ~> dec_caps[0] ~> gnd
    tvp.a33vdd ~> dec_caps[1] ~> gnd
    tvp.avdd ~> dec_caps[2] ~> gnd
    tvp.avdd ~> dec_caps[3] ~> gnd
    tvp.avdd ~> dec_caps[4] ~> gnd
    tvp.avdd ~> dec_caps[5] ~> gnd
    tvp.pll_avdd ~> dec_caps[6] ~> gnd
    tvp.pll_avdd ~> dec_caps[7] ~> gnd
    tvp.dvdd ~> dec_caps[8] ~> gnd
    tvp.dvdd ~> dec_caps[9] ~> gnd
    tvp.iovdd ~> dec_caps[10] ~> gnd
    tvp.iovdd ~> dec_caps[11] ~> gnd
    tvp.iovdd ~> dec_caps[12] ~> gnd
    tvp.iovdd ~> dec_caps[13] ~> gnd

    # --- アナログRGB入力(VGA -> RIN_3/GIN_3/BIN_3) ---
    ch_r = new VideoInputChannel
    ch_g = new VideoInputChannel
    ch_b = new VideoInputChannel
    ch_r.power ~ p3v3_a
    ch_g.power ~ p3v3_a
    ch_b.power ~ p3v3_a

    esd_rgb = new EsdArray4
    esd_rgb.gnd ~ gnd
    vga.red ~ esd_rgb.io1
    vga.green ~ esd_rgb.io2
    vga.blue ~ esd_rgb.io3

    vga.red ~ ch_r.input
    vga.green ~ ch_g.input
    vga.blue ~ ch_b.input
    ch_r.output ~ tvp.rin_3
    ch_g.output ~ tvp.gin_3
    ch_b.output ~ tvp.bin_3

    # VGA green -> SOGIN_3 (Sync-on-Green / アナログcsync対応): 1nF結合
    c_sog3 = new Capacitor
    c_sog3.capacitance = 1nF +/- 10%
    c_sog3.package = "0402"
    vga.green ~> c_sog3 ~> tvp.sogin_3

    # VGAのGND (リターン・シールド)
    vga.gnd ~ gnd
    vga.red_rtn ~ gnd
    vga.green_rtn ~ gnd
    vga.blue_rtn ~ gnd
    vga.sync_gnd ~ gnd
    vga.shield ~ gnd

    # --- TTL同期入力 (HS/VS or csync-on-HSYNC) ---
    esd_sync = new EsdArray4
    esd_sync.gnd ~ gnd
    vga.hsync ~ esd_sync.io1
    vga.vsync ~ esd_sync.io2

    # VSYNCはRC遅延(220Ω+1nF)を通す: VSYNC立ち上がりがHSYNCと完全一致すると
    # 内部同期処理が誤動作するため(datasheet推奨)
    r_vs = new Resistor
    r_vs.resistance = 220ohm +/- 5%
    r_vs.package = "0402"
    c_vs = new Capacitor
    c_vs.capacitance = 1nF +/- 10%
    c_vs.package = "0402"
    signal vs_delayed
    vga.vsync ~> r_vs ~> vs_delayed
    vs_delayed ~> c_vs ~> gnd

    buf_sync.vcc ~ p3v3_io.hv
    buf_sync.gnd ~ gnd
    c_buf = new Capacitor
    c_buf.capacitance = 100nF +/- 20%
    c_buf.package = "0402"
    buf_sync.vcc ~> c_buf ~> gnd
    vga.hsync ~ buf_sync.in_a
    vs_delayed ~ buf_sync.in_b
    buf_sync.out_a ~ tvp.hsync_a
    buf_sync.out_b ~ tvp.vsync_a

    # 未使用同期入力はGND
    tvp.hsync_b ~ gnd
    tvp.vsync_b ~ gnd

    # --- H-PLL ループフィルタ (FILT1 -> 1.5kΩ + 100nF -> PLL_F, FILT2 -> 4.7nF -> PLL_F) ---
    r_filt = new Resistor
    r_filt.resistance = 1.5kohm +/- 1%
    r_filt.package = "0402"
    c_filt1 = new Capacitor
    c_filt1.capacitance = 100nF +/- 10%
    c_filt1.package = "0402"
    c_filt2 = new Capacitor
    c_filt2.capacitance = 4.7nF +/- 10%
    c_filt2.package = "0402"
    signal filt_mid
    tvp.filt1 ~> r_filt ~> filt_mid
    filt_mid ~> c_filt1 ~> tvp.pll_f
    tvp.filt2 ~> c_filt2 ~> tvp.pll_f

    # --- 27MHz基準クロック(モード検出の安定化用) ---
    osc.vcc ~ p3v3_io.hv
    osc.en ~ p3v3_io.hv
    osc.gnd ~ gnd
    osc.out ~ tvp.ext_clk
    c_osc = new Capacitor
    c_osc.capacitance = 100nF +/- 20%
    c_osc.package = "0402"
    osc.vcc ~> c_osc ~> gnd

    # --- 未使用アナログ入力の処理(datasheet: video系10nF, SOG系1nFをGNDへ) ---
    nc_caps = new Capacitor[7]
    for c in nc_caps:
        c.capacitance = 10nF +/- 20%
        c.package = "0402"
    tvp.rin_1 ~> nc_caps[0] ~> gnd
    tvp.rin_2 ~> nc_caps[1] ~> gnd
    tvp.bin_1 ~> nc_caps[2] ~> gnd
    tvp.bin_2 ~> nc_caps[3] ~> gnd
    tvp.gin_1 ~> nc_caps[4] ~> gnd
    tvp.gin_2 ~> nc_caps[5] ~> gnd
    tvp.gin_4 ~> nc_caps[6] ~> gnd

    nc_sog_caps = new Capacitor[2]
    for c in nc_sog_caps:
        c.capacitance = 1nF +/- 10%
        c.package = "0402"
    tvp.sogin_1 ~> nc_sog_caps[0] ~> gnd
    tvp.sogin_2 ~> nc_sog_caps[1] ~> gnd

    # --- 制御ピンのストラップ ---
    tvp.pwdn ~ gnd     # 常時動作
    tvp.tms ~ gnd      # スキャンテスト無効
    tvp.clamp ~ gnd    # クランプは内部タイミング使用
    tvp.coast ~ gnd

    # I2CA -> GND: I2Cアドレス 0xB8 (7bit: 0x5C)
    r_i2ca = new Resistor
    r_i2ca.resistance = 2.2kohm +/- 5%
    r_i2ca.package = "0402"
    tvp.i2ca ~> r_i2ca ~> gnd

    # I2C プルアップ
    r_sda = new Resistor
    r_sda.resistance = 2.2kohm +/- 5%
    r_sda.package = "0402"
    r_scl = new Resistor
    r_scl.resistance = 2.2kohm +/- 5%
    r_scl.package = "0402"
    tvp.sda ~> r_sda ~> p3v3_io.hv
    tvp.scl ~> r_scl ~> p3v3_io.hv

    # RESETB: プルダウン(FPGAがHighに駆動して解除)
    r_rst = new Resistor
    r_rst.resistance = 2.2kohm +/- 5%
    r_rst.package = "0402"
    tvp.resetb ~> r_rst ~> gnd

    # --- FPGA接続 (EXT P2/P4 を1対1ミラーする 2×15 ×2) ---
    # EXT側1ヘッダのGPIOは18-20本のため、RGB24bit+制御は P2+P4 の2本に集約。
    # 直挿し(ハット)でもリボンケーブルでも同じネットで成立する。
    # 3V3/5Vピンは意図的に未接続(EXT側電源と本基板LDOを衝突させない)。GNDは共通化。
    hdr_p2 = new HeaderExtP2
    hdr_p4 = new HeaderExtP4
    hdr_p2.gnd ~ gnd
    hdr_p4.gnd ~ gnd
    # EXTの5Vピン(3ヘッダ分を束ねて電流を分散)→ SJ1 → 5Vレール
    hdr_p2.p5v_ext ~ p5v_ext
    hdr_p4.p5v_ext ~ p5v_ext

    # J2 (P2ミラー): R/G 全8bit + B上位4bit = 20 GPIO
    hdr_p2.io_j20 ~ tvp.r9
    hdr_p2.io_g20 ~ tvp.r8
    hdr_p2.io_l18 ~ tvp.r7
    hdr_p2.io_k20 ~ tvp.r6
    hdr_p2.io_m18 ~ tvp.r5
    hdr_p2.io_l20 ~ tvp.r4
    hdr_p2.io_n17 ~ tvp.r3
    hdr_p2.io_n18 ~ tvp.r2
    hdr_p2.io_u17 ~ tvp.g9
    hdr_p2.io_p18 ~ tvp.g8
    hdr_p2.io_t17 ~ tvp.g7
    hdr_p2.io_u18 ~ tvp.g6
    hdr_p2.io_p17 ~ tvp.g5
    hdr_p2.io_m17 ~ tvp.g4
    hdr_p2.io_r18 ~ tvp.g3
    hdr_p2.io_r17 ~ tvp.g2
    hdr_p2.io_c18 ~ tvp.b9
    hdr_p2.io_t18 ~ tvp.b8
    hdr_p2.io_u16 ~ tvp.b7
    hdr_p2.io_k18 ~ tvp.b6

    # J4 (P4ミラー): B下位4bit + タイミング + I2C/リセット = 12/18 GPIO
    hdr_p4.io_f2 ~ tvp.dataclk   # F2 = PCLKT7_0(クロック専用入力ボール)
    hdr_p4.io_e1 ~ tvp.b5
    hdr_p4.io_e4 ~ tvp.b4
    hdr_p4.io_h3 ~ tvp.b3
    hdr_p4.io_h5 ~ tvp.b2
    hdr_p4.io_j5 ~ tvp.hsout
    hdr_p4.io_a2 ~ tvp.vsout
    hdr_p4.io_k4 ~ tvp.sogout
    hdr_p4.io_b2 ~ tvp.fidout
    hdr_p4.io_k3 ~ tvp.sda
    hdr_p4.io_k5 ~ tvp.scl
    hdr_p4.io_b3 ~ tvp.resetb
    # 空き: F1, F3, G3, H4, J4, E19(将来: 10bit化 R/G/B[1:0] 等に使用可)

    # --- GbE出口 (EXT P1 -> J8 -> MagJack) ---
    eth = new EthernetPort
    eth.gnd ~ gnd
    eth.p5v_from_ext ~ p5v_ext  # P1の5Vピンも束ねる
    eth.chassis.override_net_name = "chassis"

    gnd.override_net_name = "gnd"
