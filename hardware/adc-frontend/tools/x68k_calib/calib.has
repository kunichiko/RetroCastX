* ===========================================================================
*  RetroCastX  X68000 校正パターン (FD ブートセクタ)
* ===========================================================================
*
*  Human68k を介さず、フロッピーの論理セクタ0から直接起動して校正用の
*  テストパターンを表示する。ADC のゲイン/オフセットを合わせるために
*  「X68000 の32階調が32コードに1:1で載っているか」を目で確認できる画面を出す。
*
*  ■ IPL ROM の仕様
*      - 論理セクタ0から 1024 バイトを $002000 へロードし、$002000 から実行
*      - ★**先頭命令は BRA.B または BRA.W でなければならない**
*      - この時点で既にスーパーバイザモードなので _B_SUPER は不要
*      出典: https://zenn.dev/morian/articles/ab313ec56c4c4f
*
*  ■ 画面
*      - IOCS _CRTMOD ($10) の d1.w=12 → 512x512 / 65536色 / 1ページ
*      - IOCS _G_CLR_ON ($90) でクリア+表示(パレット標準、アクセスページ0)
*      - GVRAM ページ0 = $C00000、1ライン 1024 バイト、1ドット 1ワード
*      - 1ワードのビット配置:  GGGGG RRRRR BBBBB I
*          G = bit15..11 / R = bit10..6 / B = bit5..1 / I = bit0
*        → ★**パレットを介さず 5bit×3 を直接指定できる。** X68000 本来の
*          32階調をそのまま出せるので、校正の基準として厳密になる。
*      出典: https://github.com/JC-000/x68000-dev-guide (graphics.md)
*            https://datacrystal.tcrf.net/wiki/X68k/IOCS
*
*  ■ 画面の構成(各バンド 64 ライン)
*      y   0- 63  グレー32段(各16px幅)  ゲイン・オフセットの同時校正
*      y  64-127  赤32段                 Rチャンネル単独
*      y 128-191  緑32段                 Gチャンネル単独
*      y 192-255  青32段                 Bチャンネル単独
*      y 256-319  1px幅の白/黒縦縞       ドット復元(逆フィルタ)の検証
*      y 320-383  2px幅
*      y 384-447  4px幅
*      y 448-511  左半分白 / 右半分黒     白レベルと黒レベルの基準
*
*  ■ 読み方
*      階調の**抜け**が見えたら → ゲインが高すぎる(コードが飛んでいる)
*      階調の**重複**が見えたら → ゲインが低すぎる(隣接階調が潰れている)
*      上端だけ重複していたら   → クリップしている
*      32段が32コードに載れば   → ロスレスが成立している証拠
*
*  ■ ★このコードは完全に PC 相対で書くこと
*      HLK は再配置情報付きの .x を吐くが、こちらはヘッダを剥がして生の
*      1024バイトとして使う。ラベル参照が絶対アドレスだと $002000 へ
*      ロードした時点で壊れる。ハードウェアアドレス($C00000 等)は
*      即値なので再配置の対象にならず、そのままで良い。
*
* ===========================================================================

WHITE		equ	$FFFE		* G=31 R=31 B=31, I=0

	.text

start:
	bra.w	main			* ★IPLの要求。先頭は必ず BRA
	.dc.b	'RetroCastX CALIB'
	.even

* ---------------------------------------------------------------------------
*  バンドごとに有効にするチャンネル。bit2=G bit1=R bit0=B
* ---------------------------------------------------------------------------
bandmask:
	.dc.w	7			* band0 グレー = G+R+B
	.dc.w	2			* band1 赤のみ
	.dc.w	4			* band2 緑のみ
	.dc.w	1			* band3 青のみ
	.even

main:
* --- 512x512 / 65536色へ ---
	moveq	#12,d1
	move.w	#$0010,d0		* _CRTMOD
	trap	#15
	move.w	#$0090,d0		* _G_CLR_ON (クリアして表示)
	trap	#15

	movea.l	#$00C00000,a0		* GVRAM ページ0
	lea	bandmask(pc),a1
	moveq	#0,d7			* y

yloop:
	move.w	d7,d6
	lsr.w	#6,d6			* band = y >> 6  (0..7)
	moveq	#0,d5			* x

xloop:
	move.w	d5,d3
	lsr.w	#4,d3			* n = x >> 4  (0..31)

	cmp.w	#4,d6
	bge	stripes

* --- 階調バンド: n から GRB を組む ---
	move.w	d3,d0
	lsl.w	#6,d0			* d0 = n<<6   → R
	move.w	d0,d1
	lsl.w	#5,d1			* d1 = n<<11  → G
	move.w	d3,d2
	lsl.w	#1,d2			* d2 = n<<1   → B

	move.w	d6,d3
	add.w	d3,d3			* ワード添字へ
	move.w	(a1,d3.w),d3		* チャンネルマスク
	moveq	#0,d4
	btst	#2,d3
	beq	no_g
	or.w	d1,d4
no_g:
	btst	#1,d3
	beq	no_r
	or.w	d0,d4
no_r:
	btst	#0,d3
	beq	no_b
	or.w	d2,d4
no_b:
	bra	put

* ---------------------------------------------------------------------------
*  band 4,5,6 = 1/2/4px の白黒縦縞。band 7 = 左半分だけ白
* ---------------------------------------------------------------------------
stripes:
	cmp.w	#7,d6
	beq	halfscr
	move.w	d6,d3
	subq.w	#4,d3			* 0,1,2
	moveq	#1,d2
	lsl.w	d3,d2			* 1,2,4(レジスタ指定なので可変幅でよい)
	move.w	d5,d3
	and.w	d2,d3
	beq	black
	bra	white

halfscr:
	cmp.w	#256,d5
	blt	white
black:
	moveq	#0,d4
	bra	put
white:
	move.w	#WHITE,d4

put:
	move.w	d4,(a0)+		* 512ワード=1024Bなので刻みがライン長と一致
	addq.w	#1,d5
	cmp.w	#512,d5
	blt	xloop

	addq.w	#1,d7
	cmp.w	#512,d7
	blt	yloop

* 描き終わったら停止。リセットで抜けてもらう
forever:
	bra	forever

	.end
