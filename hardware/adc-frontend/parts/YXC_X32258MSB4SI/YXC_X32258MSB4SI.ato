    trait is_atomic_part<manufacturer="YXC", partnumber="X32258MSB4SI", footprint="CRYSTAL-SMD_4P-L3.2-W2.5-BL.kicad_mod", symbol="X32258MSB4SI.kicad_sym", model="CRYSTAL-SMD_4P-L3.2-W2.5-BL.step">
