    signal gnd ~ pin 3
    gnd ~ pin 4
    signal io_e1 ~ pin 5
    signal io_f2 ~ pin 6
    signal io_e4 ~ pin 7
    signal io_f1 ~ pin 8
    signal io_f3 ~ pin 9
    signal io_g3 ~ pin 10
    signal io_h3 ~ pin 11
    signal io_h4 ~ pin 12
    signal io_h5 ~ pin 13
    signal io_j4 ~ pin 14
    gnd ~ pin 15
    signal p5v_ext ~ pin 16
    signal io_j5 ~ pin 17
    signal io_k3 ~ pin 18
    p3v3_ext ~ pin 19
    p3v3_ext ~ pin 20
    gnd ~ pin 21
    gnd ~ pin 22
    signal io_a2 ~ pin 23
    signal io_k5 ~ pin 24
    signal io_k4 ~ pin 25
    signal io_b3 ~ pin 26
    signal io_b2 ~ pin 27
    signal io_e19 ~ pin 28
    signal nc29 ~ pin 29
    signal nc30 ~ pin 30

