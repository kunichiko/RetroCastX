    signal eth2_1_N ~ pin 9
    signal eth2_3_N ~ pin 10
    signal eth2_1_P ~ pin 11
    signal eth2_3_P ~ pin 12
    signal nc13 ~ pin 13
    signal nc14 ~ pin 14
    signal p5v ~ pin 15
    gnd ~ pin 16
    signal nc17 ~ pin 17
    signal nc18 ~ pin 18
    p3v3 ~ pin 19
    p3v3 ~ pin 20
    gnd ~ pin 21
    gnd ~ pin 22
