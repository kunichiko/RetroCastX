component HeaderDebug20:
    """将来拡張用デバッグ端子(2×15, 2.54mm)。SO-DIMM偶数側の空きGPIO 20本を引き出す。

    SO-DIMM 偶数ピン 54〜94(pin56=GNDのみ除く)= 完全に連続した空きGPIO 20本を、
    SO-DIMM昇順 ↔ ヘッダ昇順の単調割当で出す(交差無し配線)。
    5列ごとにGNDカラムを挟むのでロジアナのGNDクリップが近くに取れる。

    ピン配置(列= (1,2),(3,4)… の標準ジグザグ):
      1,2=GND / 3-10=dbg1-8 / 11,12=GND / 13-20=dbg9-16 / 21,22=GND
      23-26=dbg17-20 / 27,28,29=GND / 30=3V3
    3V3は角(pin30、両隣はGND)に置き、GPIOへの誤ショートを避ける。
    直列保護抵抗は入れていない(必要なら各線に33〜100Ωを後付けする)。
    手実装/DNP(JLC発注除外)。
    """
    trait is_atomic_part<manufacturer="", partnumber="PinHeader_2x15_2.54", footprint="Header_2x15_P2.54mm.kicad_mod", symbol="Header_2x15.kicad_sym">
    trait has_designator_prefix<prefix="J">
    trait has_part_removed  # 手実装/DNP: 基板にFPは載せるがJLC発注しない
    signal gnd ~ pin 1
    gnd ~ pin 2
    signal dbg1 ~ pin 3
    signal dbg2 ~ pin 4
    signal dbg3 ~ pin 5
    signal dbg4 ~ pin 6
    signal dbg5 ~ pin 7
    signal dbg6 ~ pin 8
    signal dbg7 ~ pin 9
    signal dbg8 ~ pin 10
    gnd ~ pin 11
    gnd ~ pin 12
    signal dbg9 ~ pin 13
    signal dbg10 ~ pin 14
    signal dbg11 ~ pin 15
    signal dbg12 ~ pin 16
    signal dbg13 ~ pin 17
    signal dbg14 ~ pin 18
    signal dbg15 ~ pin 19
    signal dbg16 ~ pin 20
    gnd ~ pin 21
    gnd ~ pin 22
    signal dbg17 ~ pin 23
    signal dbg18 ~ pin 24
    signal dbg19 ~ pin 25
    signal dbg20 ~ pin 26
    gnd ~ pin 27
    gnd ~ pin 28
    gnd ~ pin 29
    signal p3v3 ~ pin 30


component HeaderOled:
    """SSD1306 I2C OLED(128x64)接続用 1×4 ヘッダ。ピン順 GND/VDD/SCK/SDA。
    I2CバスはTVP7002と共有(OLED既定アドレス0x3C, 他と非衝突)。手実装/DNP。"""
    trait is_atomic_part<manufacturer="", partnumber="PinHeader_1x4_2.54", footprint="Header_1x4_P2.54mm.kicad_mod", symbol="Header_1x4.kicad_sym">
    trait has_designator_prefix<prefix="J">
    trait has_part_removed  # 手実装/DNP: 基板にFPは載せるがJLC発注しない
    signal gnd ~ pin 1
    signal vdd ~ pin 2
    signal scl ~ pin 3   # SCK
    signal sda ~ pin 4

component SolderJumperClosed:
    """はんだジャンパ(2パッド)・**既定=閉**。2つのパッドが0.8mm幅の銅ブリッジで
    繋がっており、ギャップ部にマスク開口があるのでナイフで切って開に、
    再度はんだを盛れば閉に戻せる(KiCad標準 SolderJumper-2_..._Bridged と同じ作り)。

    ブリッジ断面は 0.8 × 0.035mm(1oz)で長さ0.3mm、両側の大きなパッドに熱が逃げるので
    1A以上流せる。**設計意図が「既定で繋がっている」ジャンパにはこちらを使う。**
    開放が既定のものは SolderJumper(下記)を使う。
    """
    trait is_atomic_part<manufacturer="", partnumber="SolderJumper_2_Bridged", footprint="SolderJumper_2_Bridged.kicad_mod", symbol="SolderJumper_2.kicad_sym">
    trait has_designator_prefix<prefix="JP">
    trait has_part_removed  # 銅で繋がっているだけなので実装部品は無い
    signal a ~ pin 1
    signal b ~ pin 2


component SolderJumper:
    """はんだジャンパ(2パッド)・**既定=開**(銅ブリッジ無し)。閉にするには
    はんだを盛る。既定で繋がっている必要があるものには SolderJumperClosed を使う。"""
    trait is_atomic_part<manufacturer="", partnumber="SolderJumper_2", footprint="SolderJumper_2.kicad_mod", symbol="SolderJumper_2.kicad_sym">
    trait has_designator_prefix<prefix="JP">
    trait has_part_removed  # 手実装/DNP: 基板にFPは載せるがJLC発注しない
    # 手実装(JLC発注除外)。has_part_picked無し
    signal a ~ pin 1
    signal b ~ pin 2

component SpdifRxModule:
    """光デジタル(TOSLINK)受信モジュール、3.3V動作。

    候補: Everlight PLR135/T8 / CLIFF FC684205R。LCSC: 要選定。
    注意: ピン番号は仮割り当て。フットプリント取り込み後にデータシートと必ず照合。
    """
    trait is_atomic_part<manufacturer="EVERLIGHT", partnumber="PLR135/T10", footprint="PLR135_T10.kicad_mod", symbol="PLR135_T10.kicad_sym">
    trait has_designator_prefix<prefix="J">
    trait has_part_removed  # 手実装/DNP: 基板にFPは載せるがJLC発注しない
    # 手実装(JLC発注除外)。has_part_picked無し
    signal out ~ pin 1     # S/PDIFビットストリーム(TTL)
    signal gnd ~ pin 2
    signal vcc ~ pin 3

component BoxHeader2x8Argus:
    """ArgusX(アナログRGBマトリクスセレクタ)の2x8汎用映像端子と嵌合する
    ボックスヘッダ(2.54mm, IDCリボン)。手実装/DNP。

    ピン割当(ArgusX docs/design.md 3.1 と一致):
      1=R      2=GND(R)    3=G      4=GND(G)   5=B      6=GND(B)
      7=音声L  8=音声R     9=GND(音声) 10=H(TTL/CSYNC) 11=V(TTL) 12=GND
      13=+5V   14=GND      15=VBUS  16=GND
    RetroCastXは自己給電のため 13(+5V)/15(VBUS) は未接続(NC)。GNDは全接続。
    D-SUB15入力と並列に前段へ入る代替入力(使用は排他=同時に片方のみ接続)。
    """
    trait is_atomic_part<manufacturer="", partnumber="BoxHeader_2x8_2.54", footprint="BoxHeader_2x8_P2.54mm.kicad_mod", symbol="BoxHeader_2x8.kicad_sym">
    trait has_designator_prefix<prefix="J">
    trait has_part_removed  # 手実装/DNP
    signal r ~ pin 1
    signal g ~ pin 3
    signal b ~ pin 5
    signal audio_l ~ pin 7
    signal audio_r ~ pin 8
    signal hsync ~ pin 10
    signal vsync ~ pin 11
    signal gnd ~ pin 2
    gnd ~ pin 4
    gnd ~ pin 6
    gnd ~ pin 9
    gnd ~ pin 12
    gnd ~ pin 14
    gnd ~ pin 16
    # pin 13(+5V), 15(VBUS) = NC(RetroCastXは自己給電)

component BoxHeaderAux2x5:
    """第2映像入力の 2x5 ボックスヘッダ(2.54mm, IDCリボン)。手実装/DNP。

    MSX専用ではなく、**2台目のX68000など汎用の第2入力**として使う。
    ピン番号 = フラットケーブルの導体順にしてあるので、ケーブル自作時に
    「導体のn本目 → n番ピン」で数えられる(BOXヘッダからは奇数列/偶数列に
    交互に出る)。

      1 R        2 G        3 B        4 GND
      5 音声L    6 音声R    7 CSYNC    8 GND
      9 HSYNC   10 VSYNC

    ★sync-on-green は使えない前提。緑は映像専用で、同期は CSYNC(映像レベル、
      SOGIN_2へ)か HSYNC/VSYNC(TTL、HSYNC_B/VSYNC_Bへ)を使う。
    ★MSXを繋ぐ場合は 8ピンDIN 45326 Type A から自作ケーブルで変換する:
        DIN 6=R → 1 / 7=G → 2 / 8=B → 3 / 1=GND → 4,8
        DIN 2=AUDIO(モノラル) → 5,6 の両方(ケーブル側で分岐)
        DIN 4=CSYNC → 7
      DIN の 3=AV(+5V) と 5=YS(+12V/+5V) は繋がないこと。
      出典: https://www.msx.org/wiki/RGB_(8-pin_DIN_45326)
    ★CSYNC は映像レベル(MSXで1.8Vpp)を想定。基板側で75Ω終端+1/2分圧してある。
      TTLのCSYNCを入れる場合は 9(HSYNC)へ入れて4線モード(reg 0Eh=0x53)を使う。
    """
    trait is_atomic_part<manufacturer="", partnumber="BoxHeader_2x5_2.54", footprint="BoxHeader_2x5_P2.54mm.kicad_mod", symbol="BoxHeader_2x5.kicad_sym">
    trait has_designator_prefix<prefix="J">
    trait has_part_removed  # 手実装/DNP
    signal r ~ pin 1
    signal g ~ pin 2
    signal b ~ pin 3
    signal gnd ~ pin 4
    signal audio_l ~ pin 5
    signal audio_r ~ pin 6
    signal csync ~ pin 7
    gnd ~ pin 8
    signal hsync ~ pin 9
    signal vsync ~ pin 10


component HeaderSVideo:
    """S-Video / コンポジット映像 + 音声の 2×4 ボックスヘッダ(2.54mm, IDCリボン)。手実装/DNP。

    TVP7002 の**1番系統**(GIN_1 / RIN_1 / SOGIN_1)と、**第2入力と共用の PCM1808**に繋ぐ。

        G G G G     ← 上段 (pin 2/4/6/8 すべてGND)
        R L C Y     ← 下段 (pin 7/5/3/1)。**Y側が1番ピン**

      1=Y  2=GND  3=C  4=GND  5=音声L  6=GND  7=音声R  8=GND

    **全ての信号が隣にGNDを持つ**ので、リボンケーブルでも撚り線でも帰りを取りやすい。

    ★TVP7002はコンポジットをデコードできない(digitizerであってdecoderで、
      副搬送波PLL・直交復調・Y/C分離が無い)。この端子は**8fsc線同期サンプラー**
      として使い、復調はViewer側で行う前提。詳細は docs/composite-video-plan.md。

    ★音声は**2x5ヘッダ(第2映像入力)と同じ PCM1808 を共有**する。ADCを増やさずに
      2端子で1個を使うため、双方に直列1.5kΩを入れた受動加算にしてある
      (セレクタではないので両方挿すと両方鳴る。定数の根拠は main.ato の r_mix_* 参照)。

    使い方:
      S-Video    Y → pin1 / C → pin3 / 音声 → pin5,7 / シールドと帰り → 偶数ピン
      コンポジット  芯線 → pin1 / シールド → pin2  (pin3のCは未使用)

    ★S-Video なら Y/C 分離(コムフィルタ)が不要になり、さらに C チャンネルが
      独立ゲインで8bitを使い切れる(コンポジットは140 IRE を輝度と分け合う)ので
      クロマ分解能が約4倍になる。
    """
    trait is_atomic_part<manufacturer="", partnumber="BoxHeader_2x4_2.54", footprint="BoxHeader_2x4_P2.54mm.kicad_mod", symbol="BoxHeader_2x4.kicad_sym">
    trait has_designator_prefix<prefix="J">
    trait has_part_removed  # 手実装/DNP
    signal y ~ pin 1
    signal c ~ pin 3
    signal audio_l ~ pin 5
    signal audio_r ~ pin 7
    signal gnd ~ pin 2
    gnd ~ pin 4
    gnd ~ pin 6
    gnd ~ pin 8


component MountingHoleM26:
    """基板固定用ネジ穴 M2.6(GND接続)。

    穴径 2.8mm = M2.6 のクリアランス(普通級。ねじ外径2.6 + 0.2)。
    5.6mm のアニュラーパッド付きメッキ穴で、**表裏どちらも銅が露出**する
    (KiCad標準 MountingHole_2.7mm_M2.5_Pad と同じ作り: layers "*.Cu" "*.Mask")。
    zone_connect 2 = GNDベタへベタ付け接続。

    ★金属スペーサ/金属筐体で留めると、この穴を通じて**論理GNDが筐体に落ちる**。
      本基板はMagJackのシェル用に「シャーシGNDの島」を4.7nF/2kVで論理GNDから
      分離しているので、金属筐体だとその分離がネジ経由で短絡される。
      樹脂スペーサを使うか、分離をやめる判断を意図的にすること。
    ★ネジ頭が銅に直接触れるので、頭の外径(M2.6なめしなべで約5mm)が
      隣の配線に乗らないよう、周囲はパッド径5.6mmぶん空けておく。
    穴だけなので実装対象外(JLC発注除外)。
    """
    trait is_atomic_part<manufacturer="", partnumber="MountingHole_2.8mm_M2.6", footprint="MountingHole_2.8mm_M2.6_Pad.kicad_mod", symbol="MountingHole.kicad_sym">
    trait has_designator_prefix<prefix="H">
    trait has_part_removed
    signal gnd ~ pin 1


