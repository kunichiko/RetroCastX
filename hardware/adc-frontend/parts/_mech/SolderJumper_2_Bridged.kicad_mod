(footprint "SolderJumper_2_Bridged"
	(version 20241229)
	(generator "manual")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "2-pad solder jumper, NORMALLY CLOSED: the two pads are joined by a 0.8mm-wide copper bridge across the 0.3mm gap, with a solder-mask opening over the bridge so it can be cut with a knife and re-bridged with solder. Bridge cross-section 0.8 x 0.035mm (1oz) over a 0.3mm span, well sinked into both pads - good for >1A. Use this variant wherever the design intends the jumper CLOSED by default; use SolderJumper_2 (open) otherwise.")
	(tags "solderjumper bridged normally-closed")
