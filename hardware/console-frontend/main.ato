#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

import ElectricPower
import Resistor
import Capacitor
import is_atomic_part
import has_part_picked
import has_designator_prefix
import has_part_removed
from "parts/_mech/mech.ato" import MiniDin4SVideo
from "parts/_mech/mech.ato" import RcaJack
from "parts/_mech/mech.ato" import MountingHoleM3
from "parts/_mech/mech.ato" import Fiducial
from "parts/_mech/mech.ato" import Tp1Pad
from "parts/TI_TS5A23159DGSR/TI_TS5A23159DGSR.ato" import TI_TS5A23159DGSR_package
from "parts/XINGLIGHT_XL_2020RGBC_2812B/XINGLIGHT_XL_2020RGBC_2812B.ato" import XINGLIGHT_XL_2020RGBC_2812B_package
from "parts/ST_1N4148W/ST_1N4148W.ato" import ST_1N4148W_package
from "passives.ato" import R75_0603
from "passives.ato" import R10K_0603
from "passives.ato" import C100nF_0603
from "passives.ato" import C10uF_0805

# =============================================================================
# RetroCastX 小亀基板(コンソール入力基板) v1.0
#
# Copyright Kunihiko Ohnaka
